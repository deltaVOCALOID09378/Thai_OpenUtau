<Project>
  <PropertyGroup>
    <RollForward>LatestMajor</RollForward>
    <EnableSourceControlManagerQueries Condition="'$(CI)' != 'true'">false</EnableSourceControlManagerQueries>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="true" />
  </ItemGroup>
</Project>
