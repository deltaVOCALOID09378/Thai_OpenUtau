<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="StartupSettings.props" Condition="Exists('StartupSettings.props')" />
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <RollForward>LatestMajor</RollForward>
    <OutputType>WinExe</OutputType>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>3.9.5</Version>
    <AssemblyVersion>3.9.5.0</AssemblyVersion>
    <FileVersion>3.9.5.0</FileVersion>
    <ApplicationIcon>Assets\Thai OpenUtau Logo.ico</ApplicationIcon>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <StartupObject />
    <!-- Mac OS Settings -->
    <CFBundleName>Thai OpenUtau</CFBundleName>
    <CFBundleDisplayName>Thai OpenUtau</CFBundleDisplayName>
    <CFBundleIdentifier>com.deltasynth.thaiopenutau</CFBundleIdentifier>
    <CFBundleVersion>3.9.5</CFBundleVersion>
    <CFBundleShortVersionString>3.9</CFBundleShortVersionString>
    <CFBundlePackageType>APPL</CFBundlePackageType>
    <CFBundleSignature>DLTA</CFBundleSignature>
    <CFBundleExecutable>OpenUtau</CFBundleExecutable>
    <CFBundleIconFile>Thai OpenUtau.icns</CFBundleIconFile>
    <NSPrincipalClass>NSApplication</NSPrincipalClass>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.2.4" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.4" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.4" />
    <PackageReference Include="Dotnet.Bundle" Version="0.9.13" />
    <PackageReference Include="Material.Avalonia" Version="3.13.3" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="2.2.3" />
    <PackageReference Include="ReactiveUI.Fody" Version="19.5.41" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenUtau.Core\OpenUtau.Core.csproj" />
    <ProjectReference Include="..\OpenUtau.Plugin.Builtin\OpenUtau.Plugin.Builtin.csproj" />
  </ItemGroup>
  <!-- จัดการ Native Libraries แยกตาม RuntimeIdentifier ให้ถูกต้องแม่นยำ -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <None Include="..\runtimes\win-x64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes\win-x64\native\" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <None Include="..\runtimes\win-x86\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes\win-x86\native\" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <None Include="..\runtimes\win-arm64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes\win-arm64\native\" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
    <None Include="..\runtimes\osx-x64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes\osx-x64\native\" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <None Include="..\runtimes\osx-arm64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes\osx-arm64\native\" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <None Include="..\runtimes\linux-x64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes\linux-x64\native\" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
    <None Include="..\runtimes\linux-arm64\native\**" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes\linux-arm64\native\" />
  </ItemGroup>
  <!-- สำเนาไฟล์พจนานุกรมไปยัง Output Directory อัตโนมัติ (Copy Dictionaries to Output Directory) -->
  <ItemGroup>
    <None Include="..\Dictionaries\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Dictionaries\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Controls\NotePropertyExpression.axaml.cs">
      <DependentUpon>NotePropertyExpression.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\NotePropertiesControl.axaml.cs">
      <DependentUpon>NotePropertiesControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Resources\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Views\PhonemeTimingConfigDialog.axaml.cs">
      <DependentUpon>PhonemeTimingConfigDialog.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\PasteParamDialog.axaml.cs">
      <DependentUpon>PasteParamDialog.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\GenerateHarmonyDialog.axaml.cs">
      <DependentUpon>GenerateHarmonyDialog.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CreateCustomTrackColorDialog.axaml.cs">
      <DependentUpon>CreateCustomTrackColorDialog.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\TrackColorPickerControl.axaml.cs">
      <DependentUpon>TrackColorPickerControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\TrackSettingsDialog.axaml.cs">
      <DependentUpon>TrackSettingsDialog.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\TrackColorDialog.axaml.cs">
      <DependentUpon>TrackColorDialog.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>