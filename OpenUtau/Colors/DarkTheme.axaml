<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>
  
  <!-- High-Contrast Obsidian Background Suite -->
  <Color x:Key="BackgroundColor">#121212</Color>
  <Color x:Key="BackgroundColorPointerOver">#222222</Color>
  <Color x:Key="TransportToolbarOffHoverColor">#282828</Color>
  <Color x:Key="BackgroundColorPressed">#080808</Color>
  <Color x:Key="BackgroundColorDisabled">#121212</Color>

  <!-- Crisp Brilliant White Typography -->
  <Color x:Key="ForegroundColor">#FFFFFF</Color>
  <Color x:Key="ForegroundColorPointerOver">#FFFFFF</Color>
  <Color x:Key="ForegroundColorPressed">#FFFFFF</Color>
  <Color x:Key="ForegroundColorDisabled">#888888</Color>
  <Color x:Key="TextControlBorderColorDisabled">#3E3E3E</Color>

  <!-- Sharp Defined Borders -->
  <Color x:Key="BorderColor">#383838</Color>
  <Color x:Key="BorderColorPointerOver">#505050</Color>

  <!-- DELTA SYNTH Saturated Corporate Red Palette -->
  <Color x:Key="SystemAccentColor">#D92200</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#FF3B14</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#A01000</Color>

  <Color x:Key="NeutralAccentColor">#FFFFFF</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#FF3B14</Color>
  <Color x:Key="AccentColor1">#D92200</Color>
  <Color x:Key="AccentColor1Note">#A01000</Color>
  <Color x:Key="AccentColor2">#0066FF</Color>
  <Color x:Key="AccentColor3">#FF3399</Color>

  <!-- Ultra-Crisp Sharp Notes -->
  <Color x:Key="NoteBorderColor">#FF3B14</Color>
  <Color x:Key="NoteBorderColorPressed">#D92200</Color>

  <!-- High-Contrast Grid & Timeline -->
  <Color x:Key="TickLineColor">#1C1C1C</Color>
  <Color x:Key="BarNumberColor">#FFFFFF</Color>
  <Color x:Key="FinalPitchColor">#FFFFFFFF</Color>
  <Color x:Key="TrackBackgroundAltColor">#161616</Color>
  
  <Color x:Key="WarningColor">#5C4500</Color>

  <Color x:Key="ToolbarCheckedHoverColor">#FF3B14</Color>
  <Color x:Key="ToolTipForegroundColor">#FFFFFF</Color>
  <Color x:Key="WorkspaceCanvasColor">#060606</Color>
  <Color x:Key="WorkspaceCardColor">#141414</Color>
  <Color x:Key="WorkspaceElevatedSurfaceColor">#202020</Color>
  <Color x:Key="MutedIconColor">#9E9E9E</Color>
  <Color x:Key="PianoRollTopBarToolIconOffColor">#FFFFFF</Color>
  <Color x:Key="PianoRollWaveformPeakColor">#66FFFFFF</Color>
  <Color x:Key="PianoRollToolbarStripColor">#0C0C0C</Color>
  <Color x:Key="PianoRollToolbarButtonHoverColor">#FF3B14</Color>
  <Color x:Key="PianoRollTimelineStripColor">#0A0A0A</Color>
  <Color x:Key="AppTopBarTransportStripColor">#101010</Color>
  <Color x:Key="AppTopBarTransportHoverColor">#D92200</Color>
  <Color x:Key="AppTopBarValueStripColor">#0C0C0C</Color>
  <Color x:Key="AppTopBarValueDividerColor">#222222</Color>

  <!-- High-Definition Keyboard Palette -->
  <Color x:Key="WhiteKeyColorLeft">#D5D5D5</Color>
  <Color x:Key="WhiteKeyColorRight">#F8F8F8</Color>
  <Color x:Key="WhiteKeyNameColor">#0A0A0A</Color>

  <Color x:Key="CenterKeyColorLeft">#A01000</Color>
  <Color x:Key="CenterKeyColorRight">#D92200</Color>
  <Color x:Key="CenterKeyNameColor">#FFFFFF</Color>

  <Color x:Key="BlackKeyColorLeft">Transparent</Color>
  <Color x:Key="BlackKeyColorRight">Transparent</Color>
  <Color x:Key="BlackKeyNameColor">#FFFFFF</Color>
</ResourceDictionary>
