<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>
  
  <Color x:Key="BackgroundColor">#212121</Color>
  <Color x:Key="BackgroundColorPointerOver">#2F2F2F</Color>
  <Color x:Key="TransportToolbarOffHoverColor">#3A3A3A</Color>
  <Color x:Key="BackgroundColorPressed">#2F2F2F</Color>
  <Color x:Key="BackgroundColorDisabled">#212121</Color>

  <Color x:Key="ForegroundColor">#F0F0F0</Color>
  <Color x:Key="ForegroundColorPointerOver">#FCFCFC</Color>
  <Color x:Key="ForegroundColorPressed">#FCFCFC</Color>
  <Color x:Key="ForegroundColorDisabled">#A6A6A6</Color>
  <Color x:Key="TextControlBorderColorDisabled">#4D4D4D</Color>

  <Color x:Key="BorderColor">#E0E0E0</Color>
  <Color x:Key="BorderColorPointerOver">#FCFCFC</Color>

  <!-- SystemAccentColor: เปลี่ยนจากม่วง #7271C9 → แดง DELTA SYNTH #CC2200
       ใช้เป็น Selection highlight, Focus border ทั่วทั้งแอป -->
  <Color x:Key="SystemAccentColor">#CC2200</Color>
  <!-- PointerOver: แดงสว่างขึ้น เมื่อเมาส์ hover -->
  <Color x:Key="SystemAccentColorLight1">#FF4422</Color>
  <!-- Pressed: แดงเข้มขึ้น เมื่อกด -->
  <Color x:Key="SystemAccentColorDark1">#991100</Color>

  <Color x:Key="NeutralAccentColor">#FCFCFC</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#FCFCFC</Color>
  <Color x:Key="AccentColor1">#E0E0E0</Color>
  <!-- AccentColor1Note: สีเติมภายในโน้ต จากม่วงเข้ม → แดงเข้มโปร่งใส DELTA SYNTH -->
  <Color x:Key="AccentColor1Note">#5C1010</Color>
  <!-- AccentColor2: สีหลักจากม่วง → แดง DELTA SYNTH -->
  <Color x:Key="AccentColor2">#CC2200</Color>
  <Color x:Key="AccentColor3">#FCFCFC</Color>

  <!-- NoteBorderColor: ขอบโน้ต จากม่วง #7B79D9 → แดง DELTA SYNTH -->
  <Color x:Key="NoteBorderColor">#DD3311</Color>
  <!-- NoteBorderColorPressed: เมื่อกดโน้ต → แดงสว่าง -->
  <Color x:Key="NoteBorderColorPressed">#FF5533</Color>

  <Color x:Key="TickLineColor">#060606</Color>
  <Color x:Key="BarNumberColor">#E0E0E0</Color>
  <Color x:Key="FinalPitchColor">#CAFFFFFF</Color>
  <Color x:Key="TrackBackgroundAltColor">#2A2A2A</Color>
  
  <Color x:Key="WarningColor">#433519</Color>

  <Color x:Key="ToolbarCheckedHoverColor">#D8D8D8</Color>
  <Color x:Key="ToolTipForegroundColor">#FFFFFF</Color>
  <Color x:Key="WorkspaceCanvasColor">#141414</Color>
  <Color x:Key="WorkspaceCardColor">#212121</Color>
  <Color x:Key="WorkspaceElevatedSurfaceColor">#2B2B2B</Color>
  <Color x:Key="MutedIconColor">#808080</Color>
  <Color x:Key="PianoRollTopBarToolIconOffColor">#FFFFFF</Color>
  <Color x:Key="PianoRollWaveformPeakColor">#3BFFFFFF</Color>
  <Color x:Key="PianoRollToolbarStripColor">#1F1F1F</Color>
  <Color x:Key="PianoRollToolbarButtonHoverColor">#313131</Color>
  <Color x:Key="PianoRollTimelineStripColor">#191919</Color>
  <Color x:Key="AppTopBarTransportStripColor">#323232</Color>
  <Color x:Key="AppTopBarTransportHoverColor">#454545</Color>
  <Color x:Key="AppTopBarValueStripColor">#1C1C1C</Color>
  <Color x:Key="AppTopBarValueDividerColor">#3A3A3A</Color>

  <!-- Studio keyboard: neutral ivory face with a restrained darker key edge. -->
  <Color x:Key="WhiteKeyColorLeft">#F3F1EC</Color>
  <Color x:Key="WhiteKeyColorRight">#C8C8C4</Color>
  <Color x:Key="WhiteKeyNameColor">#1A1A1A</Color>

  <!-- CenterKey (Middle C / C4): เปลี่ยนสีจากม่วง/น้ำเงิน → แดงเข้ม DELTA SYNTH -->
  <Color x:Key="CenterKeyColorLeft">#3D1010</Color>
  <Color x:Key="CenterKeyColorRight">#5C1A1A</Color>
  <!-- CenterKeyNameColor: จากน้ำเงิน/ม่วง → แดงสว่าง DELTA SYNTH -->
  <Color x:Key="CenterKeyNameColor">#FF2200</Color>

  <Color x:Key="BlackKeyColorLeft">#363636</Color>
  <Color x:Key="BlackKeyColorRight">#090909</Color>
  <Color x:Key="BlackKeyNameColor">#F0F0F0</Color>
</ResourceDictionary>
