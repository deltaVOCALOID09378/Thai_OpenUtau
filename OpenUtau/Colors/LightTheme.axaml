<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">false</system:Boolean>

  <Color x:Key="BackgroundColor">#F0F0F0</Color>
  <Color x:Key="BackgroundColorPointerOver">#E0E0E0</Color>
  <Color x:Key="TransportToolbarOffHoverColor">#EAEAEA</Color>
  <Color x:Key="BackgroundColorPressed">#D0D0D0</Color>
  <Color x:Key="BackgroundColorDisabled">#D0D0D0</Color>

  <Color x:Key="ForegroundColor">#1A1A1A</Color>
  <Color x:Key="ForegroundColorPointerOver">#111111</Color>
  <Color x:Key="ForegroundColorPressed">#000000</Color>
  <Color x:Key="ForegroundColorDisabled">#808080</Color>
  <Color x:Key="TextControlBorderColorDisabled">#BDBDBD</Color>

  <Color x:Key="BorderColor">#707070</Color>
  <Color x:Key="BorderColorPointerOver">#A0A0A0</Color>

  <Color x:Key="SystemAccentColor">#CC2200</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#FF4422</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#991100</Color>

  <Color x:Key="NeutralAccentColor">#F0F0F0</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#FF4422</Color>
  <Color x:Key="AccentColor1">#FF66B2</Color>
  <Color x:Key="AccentColor1Note">#FF66B2</Color>
  <Color x:Key="AccentColor2">#CC2200</Color>
  <Color x:Key="AccentColor3">#0055CC</Color>

  <Color x:Key="NoteBorderColor">#FF4422</Color>
  <Color x:Key="NoteBorderColorPressed">#CC2200</Color>
  
  <Color x:Key="TickLineColor">#C0C0CA</Color>
  <Color x:Key="BarNumberColor">#4F4F6E</Color>
  <Color x:Key="FinalPitchColor">#FFCC2200</Color>
  <Color x:Key="TrackBackgroundAltColor">#EAEAEA</Color>

  <Color x:Key="WarningColor">#FFF4CE</Color>

  <Color x:Key="ToolbarCheckedHoverColor">#FF4422</Color>
  <Color x:Key="ToolTipForegroundColor">#FFFFFF</Color>
  <Color x:Key="WorkspaceCanvasColor">#E4E4E8</Color>
  <Color x:Key="WorkspaceCardColor">#F0F0F0</Color>
  <Color x:Key="WorkspaceElevatedSurfaceColor">#E8E8EC</Color>
  <Color x:Key="MutedIconColor">#808080</Color>
  <Color x:Key="PianoRollTopBarToolIconOffColor">#808080</Color>
  <Color x:Key="PianoRollWaveformPeakColor">#59999999</Color>
  <Color x:Key="PianoRollToolbarStripColor">#1A1A1A</Color>
  <Color x:Key="PianoRollToolbarButtonHoverColor">#FF4422</Color>
  <Color x:Key="PianoRollTimelineStripColor">#E4E4E8</Color>
  <Color x:Key="AppTopBarTransportStripColor">#E8E8EC</Color>
  <Color x:Key="AppTopBarTransportHoverColor">#FF4422</Color>
  <Color x:Key="AppTopBarValueStripColor">#D8D8DE</Color>
  <Color x:Key="AppTopBarValueDividerColor">#C0C0C8</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">#FCFCFC</Color>
  <Color x:Key="WhiteKeyColorRight">#FCFCFC</Color>
  <Color x:Key="WhiteKeyNameColor">#1A1A1A</Color>

  <Color x:Key="CenterKeyColorLeft">#FF66B2</Color>
  <Color x:Key="CenterKeyColorRight">#FF99CC</Color>
  <Color x:Key="CenterKeyNameColor">#1A1A1A</Color>

  <Color x:Key="BlackKeyColorLeft">#1A1A1A</Color>
  <Color x:Key="BlackKeyColorRight">#1A1A1A</Color>
  <Color x:Key="BlackKeyNameColor">#F0F0F0</Color>
</ResourceDictionary>
