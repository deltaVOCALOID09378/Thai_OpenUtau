<!-- Made And Checked By DELTA SYNTH & Gemini AI -->
<!-- Original by DELTA SYNTH (Delta) -->
<!-- Version: 1.4 | Date: 2026-08-05 -->
<!-- คำอธิบาย: UI Enhancement — workspacePanelTitle opacity 0.55→0.65
     รักษา DELTA SYNTH custom styles ทั้งหมดไว้ -->

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:OpenUtau.App.Controls">

  <!-- ================================================================
       1. Global Control Resources & Corner Radius
       ================================================================ -->
  <Style Selector="Control">
    <Style.Resources>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <!-- Square corners for menus, flyouts, combo dropdowns -->
      <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
      <x:Double x:Key="MenuFlyoutThemeMinHeight">20</x:Double>
      <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
      <Thickness x:Key="MenuFlyoutSeparatorThemePadding">0</Thickness>
      <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
    </Style.Resources>
  </Style>

  <!-- ================================================================
       2. General Control Styles & Global Typography
       (การตั้งค่าฟอนต์และ UI หลัก - DELTA SYNTH Standard)
       ================================================================ -->
  <Style Selector="Window, UserControl">
    <Setter Property="TextElement.FontFamily" Value="Leelawadee UI, Microsoft YaHei, Meiryo, sans-serif"/>
    <Setter Property="TextElement.FontSize" Value="13"/>
  </Style>
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource ui.fontfamily}"/>
    <Setter Property="Icon" Value="/Assets/open-utau.ico"/>
  </Style>

  <!-- String ToolTip.Tip can inherit placement-target foreground; force white on root and text content. -->
  <Style Selector="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource ToolTipForegroundBrush}"/>
  </Style>
  <Style Selector="ToolTip TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ToolTipForegroundBrush}"/>
  </Style>
  <Style Selector="ToolTip AccessText">
    <Setter Property="Foreground" Value="{StaticResource ToolTipForegroundBrush}"/>
  </Style>

  <!-- ================================================================
       3. Menu Styles (from reference: Height=24, FontSize=12)
       ================================================================ -->
  <Style Selector="Menu">
    <Setter Property="Height" Value="24"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="8,2,8,2"/>
  </Style>
  <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
    <Setter Property="RenderTransform" Value="Scale(0.75,0.75)"/>
    <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
  </Style>
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForeground}"/>
  </Style>
  <Style Selector="MenuItem:selected /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}"/>
  </Style>
  <Style Selector="MenuItem:pressed /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPressed}"/>
  </Style>
  <Style Selector="MenuItem:disabled /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}"/>
  </Style>
  <Style Selector="MenuItem:separator">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="MinHeight" Value="1"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="MenuItem > Separator, ContextMenu > Separator, MenuItem:separator /template/ Separator">
    <Setter Property="Background" Value="{DynamicResource MutedIconBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="1" />
  </Style>
  <Style Selector="MenuItem > Separator /template/ Border,
          ContextMenu > Separator /template/ Border,
          MenuItem:separator /template/ Separator /template/ Border">
    <Setter Property="Background" Value="{DynamicResource MutedIconBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedIconBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="MenuItem.MenuItemWithSubMenu MenuItem">
    <Setter Property="Header" Value="{Binding Header}"/>
    <Setter Property="Command" Value="{Binding Command}"/>
    <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
    <Setter Property="ItemsSource" Value="{Binding Items}"/>
    <Setter Property="Height" Value="{Binding Height}"/>
    <Setter Property="Icon" Value="{Binding Icon}"/>
  </Style>
  <Style Selector="ContextMenu MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="4,2,4,2"/>
  </Style>
  <Style Selector="ContextMenu.WithCommand MenuItem">
    <Setter Property="Header" Value="{Binding Header}"/>
    <Setter Property="Command" Value="{Binding Command}"/>
    <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
  </Style>
  <Style Selector="Border.appTopBar Menu > MenuItem">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="6,0"/>
  </Style>

  <!-- ================================================================
       4. TextBlock & Label Sizes (from reference)
       ================================================================ -->
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="Label">
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- ================================================================
       5. TextBox Styles (from reference: MinHeight=20, Height=20, FontSize=12)
       ================================================================ -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Padding" Value="4,1"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
  </Style>
  <Style Selector="DataGridCell > TextBox">
    <Setter Property="Margin" Value="0"/>
  </Style>

  <!-- ================================================================
       6. Button Styles
       ================================================================ -->
  <Style Selector="Button,ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <!-- เพิ่มความโค้งมนให้ดูสวยงามทันสมัย -->
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="Background" Value="{DynamicResource AppTopBarTransportStripBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          RecognizesAccessKey="False"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover:not(:pressed):not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource TransportToolbarOffHoverBrush}"/>
  </Style>
  <Style Selector="Button:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource AppTopBarTransportHoverBrush}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}"/>
    <Setter Property="Background" Value="{DynamicResource AppTopBarTransportStripBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.iconButton">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.iconButton:pointerover:not(:pressed):not(:disabled)">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.iconButton:pointerover:not(:pressed):not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TransportToolbarOffHoverBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Button.iconButton:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppTopBarTransportHoverBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Button.iconButton:disabled">
    <Setter Property="Opacity" Value="0.45"/>
  </Style>
  <Style Selector="Button:pressed, RepeatButton:pressed, ToggleButton:pressed">
    <Setter Property="RenderTransform" Value="scale(1)"/>
  </Style>
  <Style Selector="Button.clear">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Padding" Value="4,0,4,2"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.clear:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TransportToolbarOffHoverBrush}"/>
  </Style>
  <Style Selector="Button.clear:pointerover:not(:disabled), Button.clear:pressed:not(:disabled)">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.clear.trackHeaderTextButton">
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.clear.trackHeaderTextButton.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedIconBrush}"/>
  </Style>
  <Style Selector="Button.clear.trackHeaderTextButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
          Button.clear.trackHeaderTextButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppTopBarTransportStripBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.transportChrome">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.transportChrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TransportToolbarOffHoverBrush}"/>
  </Style>
  <Style Selector="Button.transportChrome:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TransportToolbarOffPressedBrush}"/>
  </Style>

  <!-- Welcome/Action Buttons (from reference) -->
  <Style Selector="Button.welcomeRecoveryButton">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.welcomeActionButton">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="56" />
  </Style>
  <Style Selector="Button.welcomeActionButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource PianoRollSideHoverBackgroundBrush}" />
  </Style>
  <Style Selector="Button.welcomeActionButton:pressed">
    <Setter Property="Background" Value="{DynamicResource PianoRollSideHoverBackgroundBrush}" />
  </Style>
  <Style Selector="Button.singerHubActionButton">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="24"/>
  </Style>
  <!-- Close panel button (from reference) -->
  <Style Selector="Button.workspacePanelClose">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.workspacePanelClose /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.workspacePanelClose:pointerover /template/ ContentPresenter#PART_ContentPresenter,
          Button.workspacePanelClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PianoRollSideHoverBackgroundBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.workspacePanelClose Path.stroked">
    <Setter Property="Stroke" Value="{DynamicResource MutedIconBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="10"/>
    <Setter Property="Data" Value="M3,3 L11,11 M11,3 L3,11"/>
  </Style>
  <Style Selector="Button.workspacePanelClose:pointerover Path.stroked,
          Button.workspacePanelClose:pressed Path.stroked">
    <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
  </Style>

  <!-- ================================================================
       7. Transport Chip Styles for Top Toolbar
       ================================================================ -->
  <Style Selector="Button.transportChip, ToggleButton.transportChip">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Button.transportChip:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.transportChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppTopBarTransportHoverBrush}"/>
  </Style>
  <Style Selector="Button.transportChip:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.transportChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppTopBarTransportPressedBrush}"/>
  </Style>

  <!-- ================================================================
       8. CheckBox Styles (DELTA SYNTH + reference)
       ================================================================ -->
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="MinWidth" Value="20" />
  </Style>
  <Style Selector="CheckBox /template/ Grid">
    <Setter Property="Height" Value="20" />
    <Setter Property="Width" Value="20" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="CheckBox /template/ Viewbox">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource SelectedTrackAccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SelectedTrackAccentBrush}"/>
  </Style>
  <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource SelectedTrackAccentLightBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SelectedTrackAccentLightBrush}"/>
  </Style>
  <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource SelectedTrackAccentDarkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SelectedTrackAccentDarkBrush}"/>
  </Style>
  <Style Selector="CheckBox.menu">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Style Selector="^:unchecked /template/ Border#NormalRectangle">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource SelectedTrackAccentBrush}" />
      <Setter Property="Width" Value="12" />
    </Style>
    <Style Selector="^:checked /template/ Border#NormalRectangle">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Style>

  <!-- ================================================================
       9. Path & Icon Styles (DELTA SYNTH custom)
       ================================================================ -->
  <Style Selector="Path.checkmenu">
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Data" Value="M1,5 L4,8 L9,1"/>
    <Setter Property="Stroke" Value="{DynamicResource SelectedTrackAccentBrush}"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ================================================================
       10. ComboBox Styles (from reference: Height=20, FontSize=12)
       ================================================================ -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MutedIconBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Padding" Value="4,0,0,2"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="4,2,0,0"/>
  </Style>
  <Style Selector="ComboBox /template/ Path#DropDownGlyph">
    <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedIconBrush}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background,
          ComboBox:pressed /template/ Border#Background,
          ComboBox:dropdownopen /template/ Border#Background,
          ComboBox:focus /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedIconBrush}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedIconBrush}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedIconBrush}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#HighlightBackground,
          ComboBox:dropdownopen:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedTrackAccentLightBrushSemi}"/>
  </Style>
  <Style Selector="ComboBox.workspacePanelCombo ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter,
          ComboBox.workspacePanelCombo ComboBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="ComboBox.workspacePanelCombo ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
          ComboBox.workspacePanelCombo ComboBoxItem:pointerover /template/ ContentPresenter,
          ComboBox.workspacePanelCombo ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
          ComboBox.workspacePanelCombo ComboBoxItem:selected /template/ ContentPresenter,
          ComboBox.workspacePanelCombo ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
          ComboBox.workspacePanelCombo ComboBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedIconBrush}" />
  </Style>

  <!-- ================================================================
       11. ListBox / ListBoxItem Styles
       ================================================================ -->
  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedTrackAccentLightBrushSemi}"/>
  </Style>

  <!-- ================================================================
       12. Toolbar Icon Hosts: Securing the layout footprint
       ================================================================ -->
  <Style Selector="Grid.toolbarIconHost">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <!-- บังคับให้รับรู้การสัมผัสเสมอ -->
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.toolbarIconHost">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Grid.toolbarIconHostSideLayout">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Grid.toolbarIconHostSide">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.toolbarIconHostSide">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.sideToolbarToggle Grid.toolbarIconHostSide,
          ToggleButton.sideToolbarToggle Border.toolbarIconHostSide">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform">
      <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
    </Setter>
  </Style>

  <!-- ================================================================
       13. ListBox Toolbar Items: Crucial for Mouse Tool Selection
       ================================================================ -->
  <Style Selector="ListBox.toolbar:not(.toolbarStrip)">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
  </Style>

  <Style Selector="ListBoxItem.toolbar">
    <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Padding" Value="2"/>
    <!-- กำหนดสีพื้นหลังเพื่อรับ Hit Test เสมอ -->
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />

    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TransportToolbarOffHoverBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TransportToolbarOffPressedBrush}"/>
    </Style>
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>
    <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TransportToolbarOnHoverBrush}"/>
    </Style>
    <Style Selector="^:selected:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TransportToolbarOnHoverBrush}"/>
    </Style>

    <Style Selector="^.hasSubTool /template/ Path#PART_SubToolArrow">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="^.hasSubTool:pointerover /template/ Path#PART_SubToolArrow">
        <Setter Property="Opacity" Value="1.0" />
    </Style>
    <Style Selector="^ /template/ Path#PART_ToolIcon.filled">
        <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="^ Ellipse.stroked">
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="^ Path.stroked">
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Path#PART_ToolIcon">
        <Setter Property="Fill" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
    <Style Selector="^.hasSubTool:selected /template/ Path#PART_SubToolArrow">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Fill" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
    <Style Selector="^.hasSubTool:selected:pointerover /template/ Path#PART_SubToolArrow">
        <Setter Property="Opacity" Value="1.0" />
    </Style>

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6">
          <Grid Classes="toolbarIconHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- ปิดการรบกวนเมาส์จากไอคอน -->
            <Path Name="PART_ToolIcon" Classes="filled" IsHitTestVisible="False">
              <Path.RenderTransform>
                <TransformGroup>
                  <ScaleTransform ScaleX=".92" ScaleY=".92" />
                  <TranslateTransform X="-1" Y="-1"/>
                </TransformGroup>
              </Path.RenderTransform>
            </Path>
            <Path Name="PART_SubToolArrow"
                Data="M 0,4 L 4,4 L 4,0 Z"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,-1,-1"
                Opacity="0"
                ZIndex="1"
                IsHitTestVisible="False">
             <Path.RenderTransform>
                 <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
             </Path.RenderTransform>
          </Path>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ FlyoutPresenter">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
  </Style>

  <Style Selector="ListBoxItem.toolbar:pointerover, ListBoxItem.toolbar:selected, ListBoxItem.toolbar:selected:pointerover, ListBoxItem.toolbar:pressed, ListBoxItem.toolbar:selected:pressed">
    <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}"/>
  </Style>

  <!-- ================================================================
       14. Piano Roll Specific Toolbar Strips
       ================================================================ -->
  <Style Selector="ListBox.toolbar.toolbarStrip">
    <Setter Property="Background" Value="{DynamicResource PianoRollToolbarStripBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MaxHeight" Value="32" />
  </Style>
  <Style Selector="ListBox.toolbar.toolbarStrip ListBoxItem.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.topBarToolStrip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MaxHeight" Value="32" />
  </Style>
  <Style Selector="ListBox.topBarToolStrip ListBoxItem.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MaxHeight" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MaxWidth" Value="32" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ================================================================
       15. ToggleButton Styles (from reference: normal, toolbar, switch)
       ================================================================ -->
  <Style Selector="ToggleButton.normal">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Padding" Value="4,0,4,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}" />
    </Style>
    <Style Selector="^:pressed  /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushSemi}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}" />
    </Style>
  </Style>

  <Style Selector="ToggleButton.toolbar">
    <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Padding" Value="4,0,4,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TransportToolbarOffHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TransportToolbarOffPressedBrush}" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TransportToolbarOnHoverBrush}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TransportToolbarOnHoverBrush}" />
    </Style>
    <Style Selector="^ Path.filled">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="^ Ellipse.stroked">
      <Setter Property="StrokeThickness" Value="1"/>
      <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="^ Path.stroked">
      <Setter Property="StrokeThickness" Value="1"/>
      <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <!-- Checked fill = ForegroundBaseHigh: ink must be panel background for contrast. -->
    <Style Selector="^:checked Path.filled">
      <Setter Property="Fill" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
    <Style Selector="^:checked Path.stroked">
      <Setter Property="Stroke" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
    <Style Selector="^:checked Ellipse.stroked">
      <Setter Property="Stroke" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
  </Style>
  <Style Selector="ToggleButton.toolbar TextBlock.toolbarGlyphText">
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="ToggleButton.toolbar:checked TextBlock.toolbarGlyphText">
    <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
  </Style>
  <Style Selector="ToggleButton.toolbar:pointerover, ToggleButton.toolbar:pressed, ToggleButton.toolbar:checked, ToggleButton.toolbar:checked:pointerover, ToggleButton.toolbar:checked:pressed">
    <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}"/>
  </Style>
  <Style Selector="ToggleButton.switch">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AccentBrush1Note}"/>
  </Style>

  <!-- ================================================================
       16. DataGrid Styles (from reference)
       ================================================================ -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="20" />
  </Style>

  <!-- ================================================================
       17. ProgressBar Styles (from reference)
       ================================================================ -->
  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush1}"/>
  </Style>

  <!-- ================================================================
       18. Workspace Card & Layout Styles (from reference)
       ================================================================ -->
  <Style Selector="Grid.workspaceLayout">
    <Setter Property="Background" Value="{DynamicResource WorkspaceCanvasBrush}" />
  </Style>
  <Style Selector="Border.workspaceCard">
    <Setter Property="Background" Value="{DynamicResource WorkspaceCardBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <!-- Docked workspace tiles: flush to screen on outer edges; 8px gap only between blocks. -->
  <Style Selector="Border.workspaceDockTop">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.workspaceDockTracks">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Margin" Value="0,0,0,0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.workspaceDockPianoHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Border.workspaceDockPianoRollSide">
    <Setter Property="CornerRadius" Value="0,8,8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="Border.workspaceCard.workspaceDockAppearance,
                 Border.workspaceDockAppearance">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Border.workspaceCard.workspaceDockThemeEditor,
                 Border.workspaceDockThemeEditor">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Border.workspaceDockPianoRoll,
                 Border.workspaceDockPianoRollMain,
                 Border.workspaceDockPianoRollPhoneme,
                 Border.workspaceDockPianoRollExp">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.workspaceDockPianoRoll.FlushRight,
                 Border.workspaceDockPianoRollMain.FlushRight,
                 Border.workspaceDockPianoRollPhoneme.FlushRight,
                 Border.workspaceDockPianoRollExp.FlushRight">
    <Setter Property="CornerRadius" Value="8,0,0,8" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.workspaceDockPianoRoll.FlushLeft,
                 Border.workspaceDockPianoRollMain.FlushLeft,
                 Border.workspaceDockPianoRollPhoneme.FlushLeft,
                 Border.workspaceDockPianoRollExp.FlushLeft">
    <Setter Property="CornerRadius" Value="0,8,8,0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.workspaceDockPianoRoll.FlushLeft.FlushRight,
                 Border.workspaceDockPianoRollMain.FlushLeft.FlushRight,
                 Border.workspaceDockPianoRollPhoneme.FlushLeft.FlushRight,
                 Border.workspaceDockPianoRollExp.FlushLeft.FlushRight">
    <Setter Property="CornerRadius" Value="0,0,0,0" />
  </Style>
  <Style Selector="Border.workspaceDockNoteProps">
    <Setter Property="CornerRadius" Value="8,0,0,8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="TextBlock.workspacePanelTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.65" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="TextBlock.notePropsPanelTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Welcome (home) screen (from reference) -->
  <Style Selector="Border.welcomeCard">
    <Setter Property="Background" Value="{DynamicResource WorkspaceCardBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.welcomeHubShell">
    <Setter Property="Background" Value="{DynamicResource WorkspaceCardBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,12,12,8" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <!-- TextBlock Welcome variants (from reference) -->
  <Style Selector="TextBlock.welcomeActionTitle">
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBlock.welcomeActionDescription">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Opacity" Value="0.65"/>
  </Style>
  <Style Selector="TextBlock.welcomeFileName">
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBlock.welcomeFilePath">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Opacity" Value="0.55"/>
  </Style>
  <Style Selector="TextBlock.appTopBarLabel">
    <Setter Property="FontSize" Value="15"/>
  </Style>

  <!-- ================================================================
       19. Tool Icons Data Definitions (Cursor, Pen, Eraser, etc.)
       ================================================================ -->
  <Style Selector="ListBoxItem.cursorTool /template/ Path#PART_ToolIcon">
    <Setter Property="Data" Value="M10.07,14.27C10.57,14.03 11.16,14.25 11.4,14.75L13.7,19.74L15.5,18.89L13.19,13.91C12.95,13.41 13.17,12.81 13.67,12.58L13.95,12.5L16.25,12.05L8,5.12V15.9L9.82,14.43L10.07,14.27M13.64,21.97C13.14,22.21 12.54,22 12.31,21.5L10.13,16.76L7.62,18.78C7.45,18.92 7.24,19 7,19A1,1 0 0,1 6,18V3A1,1 0 0,1 7,2C7.24,2 7.47,2.09 7.64,2.23L7.65,2.22L19.14,11.86C19.57,12.22 19.62,12.85 19.27,13.27C19.12,13.45 18.91,13.57 18.7,13.61L15.54,14.23L17.74,18.96C18,19.46 17.76,20.05 17.26,20.28L13.64,21.97Z" />
  </Style>
  <Style Selector="ListBoxItem.penTool /template/ Path#PART_ToolIcon">
    <Setter Property="Data" Value="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z" />
  </Style>
  <Style Selector="ListBoxItem.eraserTool /template/ Path#PART_ToolIcon">
    <Setter Property="Data" Value="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z" />
  </Style>

</Styles>
