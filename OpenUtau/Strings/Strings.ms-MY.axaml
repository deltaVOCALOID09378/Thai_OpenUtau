  <system:String x:Key="dialogs.about.caption">Mengenai OpenUTAU</system:String>
  <system:String x:Key="dialogs.about.message">OpenUtau bertujuan untuk menjadi persekitaran penyuntingan sumber terbuka untuk komuniti UTAU, dengan pengalaman pengguna moden dan sokongan fonologi pintar. Lawati kami di Github.</system:String>
