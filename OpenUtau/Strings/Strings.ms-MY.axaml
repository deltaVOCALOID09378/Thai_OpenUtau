  <system:String x:Key="tip.aliasbox">Tolak Alias</system:String>
  <system:String x:Key="tip.exps">Berangka, Jenis Pilihan
    Lukis Butang Kiri: Tetapkan ungkapan
    Shift + Lukis Butang Kiri: Tetapkan ungkapan seragam
    Lukis Butang Kanan: Tetapkan semula ungkapan
Jenis Lengkung
    Lukis Butang Kiri: Lukis
    Shift + Ctrl + Lukis Butang Kiri: Lukis Garisan
    Shift + Cabutan Butang Kiri: Cabutan Garisan Mendatar
    Lukis Butang Kanan: Tetapkan Semula Garisan</system:String>
  <system:String x:Key="tip.exps.notsupported">Ungkapan tidak disokong oleh pemapar</system:String>
