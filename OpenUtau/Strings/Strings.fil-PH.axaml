  <system:String x:Key="dialogs.recovery">Dati, hindi normal na natapos ang OpenUtau. Mag-click dito para mabawi.</system:String>
  <system:String x:Key="dialogs.recovery.caption">Proyekto sa pagbawi</system:String>
  <system:String x:Key="dialogs.remaptimeaxis.message">Babaguhin ng tool na ito ang tempo ng proyekto nang hindi binabago ang aktwal na mga posisyon at tagal (sa mga segundo) ng mga tala.
  Bagong BPM:</system:String>
