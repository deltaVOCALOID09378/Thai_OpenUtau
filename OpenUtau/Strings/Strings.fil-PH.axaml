  <system:String x:Key="dialogs.about.caption">Tungkol sa OpenUTAU</system:String>
  <system:String x:Key="dialogs.about.message">Layunin ng OpenUtau na maging isang open source na kapaligiran sa pag-edit para sa komunidad ng UTAU, na may modernong karanasan ng user at matalinong phonological na suporta. Bisitahin kami sa Github.</system:String>
  <system:String x:Key="dialogs.dropproject.caption">Buksan o i-import ang proyekto</system:String>
  <system:String x:Key="dialogs.dropproject.import">Mag-import ng mga track</system:String>
  <system:String x:Key="dialogs.dropproject.message">Gusto mo bang buksan ang nahulog na file ng proyekto, o i-import ang mga track nito sa kasalukuyang proyekto?</system:String>
  <system:String x:Key="dialogs.dropproject.open">Buksan ang proyekto</system:String>
  <system:String x:Key="dialogs.exitsave.caption">Lumabas sa OpenUtau</system:String>
  <system:String x:Key="dialogs.exitsave.message">Ang kasalukuyang proyekto ay naglalaman ng mga hindi na-save na pagbabago. Gusto mo bang i-save ito?</system:String>
  <system:String x:Key="dialogs.export.caption">I-export</system:String>
  <system:String x:Key="dialogs.export.savefirst">I-save muna ang project file</system:String>
  <system:String x:Key="dialogs.exportds.caption">I-export ang script ng DiffSinger</system:String>
  <system:String x:Key="dialogs.exportds.curves">Mga kurba</system:String>
  <system:String x:Key="dialogs.exportds.notrendered">Mangyaring i-render ang lahat ng bahagi bago i-export.</system:String>
  <!--<system:String x:Key="dialogs.exportds.pitch">Pitch (f0)</system:String>-->
  <system:String x:Key="dialogs.exportds.variance">Mga parameter ng pagkakaiba-iba</system:String>
  <system:String x:Key="dialogs.exportds.variance.hint">I-enable ang DiffSinger tensor cache sa Preferences para i-export ang mga curve ng parameter ng variance.</system:String>
  <system:String x:Key="dialogs.harmony.caption">Bumuo ng Harmonies</system:String>
  <system:String x:Key="dialogs.harmony.description">Gumawa ng mga bagong harmony track mula sa napiling bahagi. Ang mga tala ay inilipat sa diatonically sa napiling key.</system:String>
  <system:String x:Key="dialogs.harmony.hint">Ang bawat napiling boses ay lumilikha ng bagong track sa ibaba ng pinagmulan na may mga inilipat na tala. Ang mang-aawit at mga setting ay kinopya mula sa pinagmulang track.</system:String>
  <system:String x:Key="dialogs.harmony.intervals">Harmony na boses</system:String>
  <system:String x:Key="dialogs.harmony.key">Susi</system:String>
