  <system:String x:Key="dialogs.about.caption">ओपनयूटीएयू के बारे में</system:String>
  <system:String x:Key="dialogs.about.message">OpenUtau का लक्ष्य आधुनिक उपयोगकर्ता अनुभव और बुद्धिमान ध्वनिविज्ञान समर्थन के साथ UTAU समुदाय के लिए एक खुला स्रोत संपादन वातावरण बनना है। जीथब पर हमसे मिलें।</system:String>
  <system:String x:Key="dialogs.dropproject.caption">प्रोजेक्ट खोलें या आयात करें</system:String>
  <system:String x:Key="dialogs.dropproject.import">ट्रैक आयात करें</system:String>
  <system:String x:Key="dialogs.dropproject.message">क्या आप छोड़ी गई प्रोजेक्ट फ़ाइल को खोलना चाहते हैं, या उसके ट्रैक को वर्तमान प्रोजेक्ट में आयात करना चाहते हैं?</system:String>
  <system:String x:Key="dialogs.dropproject.open">ओपन प्रोजेक्ट</system:String>
  <system:String x:Key="dialogs.exitsave.caption">OpenUtau से बाहर निकलें</system:String>
