  <system:String x:Key="dialogs.exportds.curves">घटता</system:String>
  <system:String x:Key="dialogs.exportds.notrendered">कृपया निर्यात करने से पहले सभी भागों को प्रस्तुत करें।</system:String>
  <system:String x:Key="dialogs.exportds.pitch">पिच (f0)</system:String>
  <system:String x:Key="dialogs.exportds.variance">विचरण पैरामीटर</system:String>
  <system:String x:Key="dialogs.exportds.variance.hint">विचरण पैरामीटर वक्रों को निर्यात करने के लिए प्राथमिकताओं में डिफसिंगर टेंसर कैश सक्षम करें।</system:String>
  <system:String x:Key="dialogs.harmony.caption">सामंजस्य उत्पन्न करें</system:String>
  <system:String x:Key="dialogs.harmony.description">चयनित भाग से नए हार्मनी ट्रैक बनाएं। नोट्स को चुनी गई कुंजी में डायटोनिकली ट्रांसपोज़ किया जाता है।</system:String>
  <system:String x:Key="dialogs.harmony.hint">प्रत्येक चयनित आवाज़ ट्रांसपोज़्ड नोट्स के साथ स्रोत के नीचे एक नया ट्रैक बनाती है। सिंगर और सेटिंग्स को सोर्स ट्रैक से कॉपी किया गया है।</system:String>
