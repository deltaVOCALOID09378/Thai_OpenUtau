  <system:String x:Key="context.pitch.easeinout">〰️ โค้งเข้าและออก (Ease in/out)</system:String>
  <system:String x:Key="context.pitch.easeout">📉 โค้งออก (Ease out)</system:String>
  <system:String x:Key="context.pitch.linear">📏 เส้นตรง (Linear)</system:String>
  <system:String x:Key="context.pitch.shape">〰️ รูปแบบเส้นโค้ง (Curve shape)</system:String>
  <system:String x:Key="context.pitch.smooth">🌊 โค้งนุ่มนวล (Smooth)</system:String>
