  <!-- Errors -->
  <system:String x:Key="errors.caption">🚨 เกิดข้อผิดพลาด</system:String>
  <system:String x:Key="errors.details">🔍 รายละเอียดของปัญหา</system:String>
  <system:String x:Key="errors.diffsinger.downloadvocoder">🚨 ขัดข้องในการโหลด Vocoder "{0}" โปรดดาวน์โหลด Vocoder จาก {1} ก่อนนะครับ</system:String>
  <system:String x:Key="errors.diffsinger.downloadvocoder1">🚨 ขัดข้องในการโหลด Vocoder </system:String>
  <system:String x:Key="errors.diffsinger.downloadvocoder2">. โปรดดาวน์โหลด Vocoder จาก </system:String>
  <system:String x:Key="errors.editing.autopitch.unsupported">⚠️ ฐานเสียงที่ใช้อยู่ยังไม่รองรับการสร้างกราฟ Pitch อัตโนมัตินะครับ แนะนำให้ใช้ฐานเสียง DiffSinger หรือ Enunu ครับ</system:String>
  <system:String x:Key="errors.encryptedarchive">🚨 ไม่รองรับไฟล์บีบอัดที่เข้ารหัสลับ (Encrypted) รบกวนเปิดโฟลเดอร์ Singer ผ่านเมนู เครื่องมือ > การตั้งค่าระบบ > ตำแหน่งไฟล์ แล้วแตกไฟล์ด้วยตัวเองนะครับ</system:String>
  <system:String x:Key="errors.expression.abbrlong">⚠️ ชื่อย่อของพารามิเตอร์ต้องมีความยาว 1 ถึง 4 ตัวอักษรเท่านั้นครับ</system:String>
  <system:String x:Key="errors.expression.abbrset">⚠️ กรุณากำหนดชื่อย่อให้พารามิเตอร์ด้วยครับ</system:String>
  <system:String x:Key="errors.expression.abbrunique">⚠️ ชื่อย่อของพารามิเตอร์ต้องไม่ซ้ำกันครับ</system:String>
  <system:String x:Key="errors.expression.customDefault">⚠️ ค่าเริ่มต้นของโปรเจกต์/แทร็ก ต้องอยู่ระหว่างค่าต่ำสุดถึงสูงสุดครับ</system:String>
  <system:String x:Key="errors.expression.default">⚠️ ค่าเริ่มต้นต้องอยู่ระหว่างค่าต่ำสุด (min) และสูงสุด (max) ครับ</system:String>
  <system:String x:Key="errors.expression.flagunique">⚠️ ค่า Flag ต้องไม่ซ้ำกันครับ</system:String>
  <system:String x:Key="errors.expression.marge">⚠️ พารามิเตอร์ต่อไปนี้ถูกรวมเข้าด้วยกัน เนื่องจากมีค่า Flag ซ้ำกันครับ</system:String>
  <system:String x:Key="errors.expression.min">⚠️ ค่าขั้นต่ำ (min) ต้องน้อยกว่าค่าสูงสุด (max) เสมอครับ</system:String>
  <system:String x:Key="errors.expression.name">⚠️ กรุณาตั้งชื่อพารามิเตอร์ด้วยครับ</system:String>
  <system:String x:Key="errors.failed.export">🚨 ไม่สามารถส่งออกไฟล์ได้ครับ</system:String>
  <system:String x:Key="errors.failed.importaudio">🚨 ไม่สามารถนำเข้าไฟล์เสียงได้ครับ</system:String>
  <system:String x:Key="errors.failed.importfiles">🚨 ไม่สามารถนำเข้าไฟล์ได้ครับ</system:String>
  <system:String x:Key="errors.failed.importmidi">🚨 ไม่สามารถนำเข้าไฟล์ MIDI ได้ครับ</system:String>
  <system:String x:Key="errors.failed.importustandothers">🚨 นำเข้าไม่สำเร็จ! โปรเจกต์มีไฟล์ UST ผสมกับรูปแบบไฟล์อื่นครับ</system:String>
  <system:String x:Key="errors.failed.importustflags">⚠️ ไม่สามารถนำเข้า Flag ที่ไม่ได้กำหนดไว้ในโปรเจกต์ได้ดังนี้:</system:String>
  <system:String x:Key="errors.failed.installsinger">🚨 เกิดข้อผิดพลาด! ไม่สามารถติดตั้งนักร้องได้ครับ</system:String>
  <system:String x:Key="errors.failed.load">🚨 เกิดข้อผิดพลาดในการโหลดข้อมูลครับ</system:String>
  <system:String x:Key="errors.failed.loadprefs">🚨 เกิดข้อผิดพลาดในการโหลดไฟล์ตั้งค่า (Prefs) ระบบได้คืนค่าเริ่มต้นใหม่ให้แล้วครับ</system:String>
  <system:String x:Key="errors.failed.openfile">🚨 ไม่สามารถเปิดไฟล์นี้ได้ครับ</system:String>
  <system:String x:Key="errors.failed.openlocation">🚨 ไม่สามารถเปิดตำแหน่งที่เก็บไฟล์ได้ครับ</system:String>
  <system:String x:Key="errors.failed.opennewerproject">🚨 อ๊ะ! โปรเจกต์นี้ถูกเซฟด้วยเวอร์ชันที่ใหม่กว่า โปรดอัปเดต OpenUtau ให้เป็นเวอร์ชันล่าสุดด้วยนะครับ!</system:String>
  <system:String x:Key="errors.failed.render">🚨 ล้มเหลวในการเรนเดอร์เสียงประมวลผลครับ</system:String>
  <system:String x:Key="errors.failed.runeditingmacro">🚨 ล้มเหลวในการรันมาโคร (Macro) การแก้ไขครับ</system:String>
  <system:String x:Key="errors.failed.save">🚨 ไม่สามารถเซฟบันทึกผลงานได้ครับ</system:String>
  <system:String x:Key="errors.failed.savesingerconfig">🚨 ไม่สามารถเซฟบันทึกการตั้งค่านักร้องได้ครับ</system:String>
  <system:String x:Key="errors.failed.searchsinger">🚨 ค้นหานักร้องไม่สำเร็จครับ</system:String>
  <system:String x:Key="errors.failed.synth.cutoffbeforeoffset">🚨 ตรวจพบปัญหา OTO: ค่า Cutoff อยู่ก่อนหน้าค่า Offset ครับ</system:String>
