  <!-- Dialogs -->
  <system:String x:Key="dialogs.about.caption">ℹ️ เกี่ยวกับ OpenUtau</system:String>
  <system:String x:Key="dialogs.about.message">
    OpenUtau คือแพลตฟอร์มเสียงสังเคราะห์ระบบเปิดที่เปี่ยมไปด้วยศักยภาพ 🌟 สร้างขึ้นเพื่อชุมชนผู้ใช้ UTAU โดยมอบอิสระในการปรับแต่งอย่างแท้จริง มาร่วมเปิดประสบการณ์ที่ลื่นไหล ทันสมัย และชาญฉลาดไปกับเรา! 🚀 แวะไปทักทายพวกเราได้ที่ Github นะครับ
  </system:String>
  <system:String x:Key="dialogs.exitsave.caption">🚪 ออกจากโปรแกรม OpenUtau</system:String>
  <system:String x:Key="dialogs.exitsave.message">⚠️ ผลงานชิ้นเอกของคุณยังไม่ได้บันทึกเลยนะครับ! ต้องการเซฟความคืบหน้านี้ไว้ก่อนปิดโปรแกรมไหมครับ? 💾</system:String>
  <system:String x:Key="dialogs.export.caption">📤 ส่งออกผลงาน</system:String>
  <system:String x:Key="dialogs.export.savefirst">💾 โปรดบันทึกโปรเจกต์ก่อนทำการส่งออกเสมอนะครับ</system:String>
  <system:String x:Key="dialogs.exportds.caption">📤 ส่งออกสคริปต์ DiffSinger</system:String>
  <system:String x:Key="dialogs.exportds.curves">〰️ เส้นโค้งต่างๆ (Curves)</system:String>
  <system:String x:Key="dialogs.exportds.pitch">🎵 ระดับเสียง (Pitch/f0)</system:String>
  <system:String x:Key="dialogs.exportds.variance">🎲 พารามิเตอร์ความแปรปรวน (Variance)</system:String>
  <system:String x:Key="dialogs.exportds.variance.hint">💡 เปิดใช้งาน "DiffSinger Tensor Cache" ในการตั้งค่า เพื่อส่งออกเส้นโค้งความแปรปรวนครับ</system:String>
  <system:String x:Key="dialogs.exportds.notrendered">⚠️ กรุณารอประมวลผล (Render) พาร์ททั้งหมดให้เสร็จสิ้นก่อนทำการส่งออกครับ</system:String>
  <system:String x:Key="dialogs.importtracks.caption">📥 นำเข้าแทร็ก</system:String>
  <system:String x:Key="dialogs.importtracks.importtempo">⏱️ โปรเจกต์ที่นำเข้ามีตัวกำหนดความเร็ว (Tempo) ติดมาด้วย คุณต้องการใช้งานมันด้วยไหมครับ?</system:String>
  <system:String x:Key="dialogs.importproject.caption">📥 ตัวเลือกการนำเข้าโปรเจกต์</system:String>
  <system:String x:Key="dialogs.importproject.message">เลือกสิ่งที่คุณต้องการนำเข้าจากไฟล์นี้ได้เลยครับ:</system:String>
  <system:String x:Key="dialogs.importproject.notes">🎵 ตัวโน้ตและเนื้อเพลง</system:String>
  <system:String x:Key="dialogs.importproject.pitch">〰️ เส้นระดับเสียง (PITD)</system:String>
  <system:String x:Key="dialogs.importproject.tempo">⏱️ ตัวกำหนดความเร็ว (Tempo)</system:String>
  <system:String x:Key="dialogs.importproject.timesig">🎼 เครื่องหมายกำหนดจังหวะ (Time Signatures)</system:String>
  <system:String x:Key="dialogs.importproject.defaultlyric">📝 เนื้อเพลงค่าเริ่มต้น</system:String>
  <system:String x:Key="dialogs.importproject.fillgaps">🔗 เติมเต็มช่องว่างสั้นๆ ระหว่างโน้ต</system:String>
  <system:String x:Key="dialogs.importproject.fillgaps.threshold">ความยาวสูงสุดที่จะทำงาน (เว้น)</system:String>
  <system:String x:Key="dialogs.importproject.fillgaps.thresholditem">โน้ต 1/{0}</system:String>
  <system:String x:Key="dialogs.importproject.leadingpadding">ระยะขอบก่อนเริ่มโน้ตตัวแรก</system:String>
  <system:String x:Key="dialogs.importproject.leadingpadding.size">เติมระยะขอบเมื่อโน้ตตัวแรกชิดขอบจุดเริ่มต้น</system:String>
  <system:String x:Key="dialogs.importproject.resolveoverlaps">🛠️ ซ่อมแซมโน้ตที่ทับซ้อนกัน</system:String>
  <system:String x:Key="dialogs.importproject.lyricssection">การประมวลผลเนื้อเพลง</system:String>
  <system:String x:Key="dialogs.importproject.japanese">🇯🇵 เนื้อเพลงภาษาญี่ปุ่น</system:String>
  <system:String x:Key="dialogs.importproject.japanese.none">ไม่มีการแปลง</system:String>
  <system:String x:Key="dialogs.importproject.japanese.hiragana">โรมาจิ → ฮิรางานะ</system:String>
  <system:String x:Key="dialogs.importproject.japanese.romaji">ฮิรางานะ → โรมาจิ</system:String>
  <system:String x:Key="dialogs.importproject.chinesepinyin">🇨🇳 อักษรจีน (Hanzi) → พินอิน (Pinyin)</system:String>
  <system:String x:Key="dialogs.importproject.lyricsmapping">การจับคู่เนื้อเพลงแบบตรงตัว</system:String>
  <system:String x:Key="dialogs.importproject.lyricsmapping.hint">ใส่บรรทัดละ 1 คู่ รูปแบบ: จาก=ถึง (เช่น a=อ้า)</system:String>
  <system:String x:Key="dialogs.importproject.lyricsreplace">การแทนที่เนื้อเพลง (Replace)</system:String>
  <system:String x:Key="dialogs.importproject.lyricsreplace.hint">รูปแบบ: จาก=>ถึง หรือ /pattern/replacement/ (รองรับ Regex)</system:String>
  <system:String x:Key="dialogs.dropproject.caption">📂 เปิดหรือนำเข้าโปรเจกต์</system:String>
  <system:String x:Key="dialogs.dropproject.message">คุณต้องการ "เปิดเป็นโปรเจกต์ใหม่" หรือ "นำเข้าแทร็ก" ลงในโปรเจกต์ที่ทำอยู่ครับ?</system:String>
  <system:String x:Key="dialogs.dropproject.open">📂 เปิดเป็นโปรเจกต์ใหม่</system:String>
  <system:String x:Key="dialogs.dropproject.import">📥 นำเข้าเป็นแทร็กเสริม</system:String>
  <system:String x:Key="dialogs.installdependency.caption">📦 กำลังติดตั้งส่วนเสริม (Dependency)</system:String>
  <system:String x:Key="dialogs.installdependency.message">กำลังติดตั้ง </system:String>
  <system:String x:Key="dialogs.installdll.caption">🛠️ กำลังติดตั้ง Phonemizer</system:String>
  <system:String x:Key="dialogs.installdll.message">กำลังติดตั้ง </system:String>
  <system:String x:Key="dialogs.merge.caption">🔗 การรวมพาร์ท (Merging Parts)</system:String>
  <system:String x:Key="dialogs.merge.multitracks">⚠️ พาร์ทที่อยู่คนละแทร็กกัน ไม่สามารถนำมารวมกันได้นะครับ</system:String>
  <system:String x:Key="dialogs.splitpart.caption">✂️ กำลังตัดแบ่งพาร์ท</system:String>
  <system:String x:Key="dialogs.splitpart.intheway">⚠ พบตัวโน้ตทับซ้อนอยู่ตรงเส้นเล่นพอดีครับ\nคุณต้องการตัดที่ตำแหน่งว่างถัดไปที่ใกล้ที่สุดแทนไหมครับ?</system:String>
  <system:String x:Key="dialogs.messagebox.cancel">❌ ยกเลิก</system:String>
  <system:String x:Key="dialogs.messagebox.copy">📋 คัดลอกข้อผิดพลาดไปยังคลิปบอร์ด</system:String>
  <system:String x:Key="dialogs.messagebox.no">🙅 ไม่</system:String>
  <system:String x:Key="dialogs.messagebox.ok">✅ ตกลง</system:String>
  <system:String x:Key="dialogs.messagebox.yes">🙋 ใช่</system:String>
  <system:String x:Key="dialogs.noresampler.caption">⚠️ ไม่พบเอนจิน Resampler</system:String>
  <system:String x:Key="dialogs.noresampler.message">อ๊ะ! ระบบหาเอนจิน Resampler ไม่เจอครับ 😅 รบกวนนำไฟล์ .exe หรือ .dll ของ Resampler ไปวางในโฟลเดอร์ Resamplers และอย่าลืมเลือกใช้งานในตั้งค่าด้วยนะครับ ⚙️</system:String>
  <system:String x:Key="dialogs.recovery">🚨 พบว่า OpenUtau ปิดตัวลงผิดปกติในครั้งก่อนหน้า คลิกที่นี่เพื่อกู้คืนโปรเจกต์ครับ</system:String>
  <system:String x:Key="dialogs.recovery.caption">🩹 กู้คืนโปรเจกต์ (Recovery)</system:String>
  <system:String x:Key="dialogs.remaptimeaxis.message">เครื่องมือนี้จะปรับจังหวะของโปรเจกต์ โดยที่ตำแหน่งและความยาว (วินาที) ของตัวโน้ตยังคงเดิมครับ\nBPM ใหม่ที่ต้องการ:</system:String>
  <system:String x:Key="dialogs.harmony.caption">🎶 สร้างเสียงประสาน (Generate Harmonies)</system:String>
  <system:String x:Key="dialogs.harmony.description">สร้างแทร็กเสียงประสานใหม่จากพาร์ทที่คุณเลือก โดยโน้ตจะถูกปรับสเกลตามคีย์ที่กำหนดให้อัตโนมัติครับ</system:String>
  <system:String x:Key="dialogs.harmony.key">คีย์ (Key)</system:String>
  <system:String x:Key="dialogs.harmony.intervals">ระยะคู่เสียงประสาน (Harmony voices)</system:String>
  <system:String x:Key="dialogs.harmony.hint">เสียงที่เลือกจะถูกสร้างเป็นแทร็กใหม่ด้านล่าง พร้อมกับคัดลอกการตั้งค่าเสียงนักร้องมาจากแทร็กต้นฉบับครับ</system:String>
  <system:String x:Key="harmony.interval.thirdabove">คู่ 3 สูง (3+)</system:String>
  <system:String x:Key="harmony.interval.thirdbelow">คู่ 3 ต่ำ (3-)</system:String>
  <system:String x:Key="harmony.interval.fifthabove">คู่ 5 สูง (5+)</system:String>
  <system:String x:Key="harmony.interval.fifthbelow">คู่ 5 ต่ำ (5-)</system:String>
