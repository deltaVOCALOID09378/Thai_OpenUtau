  <system:String x:Key="tracks.selectsinger">🎤 คัดเลือกศิลปินผู้ให้เสียงร้อง</system:String>
  <system:String x:Key="tracks.singerdefault">(ใช้ค่าเดิมของนักร้อง) </system:String>
