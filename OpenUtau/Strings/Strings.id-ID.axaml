  <system:String x:Key="tip.aliasbox">Timpa Alias</system:String>
  <system:String x:Key="tip.exps">Tipe Numerik, Opsi
    Gambar Tombol Kiri: Atur ekspresi (expressions)
    Shift + Gambar Tombol Kiri: Atur ekspresi (expressions) seragam
    Gambar Tombol Kanan: Atur ulang ekspresi (expressions)
Tipe Kurva
    Gambar Tombol Kiri: Gambar
    Shift + Ctrl + Gambar Tombol Kiri: Gambar Garis (Line Draw)
    Shift + Gambar Tombol Kiri: Gambar Garis Horizontal (Horizontal Line Draw)
    Gambar Tombol Kanan: Atur ulang Garis</system:String>
  <system:String x:Key="tip.exps.notsupported">Ekspresi (Expression) tidak didukung oleh perender (renderer)</system:String>
  <system:String x:Key="tip.lyricbox.next">Tab: Nada (Note) Berikutnya</system:String>
  <system:String x:Key="tip.lyricbox.prev">Shift+Tab: Nada (Note) Sebelumnya</system:String>
  <system:String x:Key="tip.notes.basics">Alat Seleksi (Selection Tool)
    Pilih Kotak (Box Select): Pilih nada (notes)
    Ctrl + Pilih Kotak (Box Select): Pilih lebih banyak nada (notes)
    Atas/Bawah: Transposisi (Transpose) nada (notes) terpilih
    Ctrl + Atas/Bawah: Transposisi (Transpose) nada (notes) terpilih per oktaf (octave)
Alat Pena (Pen Tool)
    Gambar Tombol Kiri: Tambah nada (note)
    Klik Kanan: Hapus nada (note)
    Gambar Tombol Kanan: Hapus beberapa nada (notes)
Umum
    T: Alihkan kiat
    Seret Nada (Note): Pindahkan nada (note)
    Seret Ujung Nada (Note): Ubah ukuran nada (note)
    Alt + Seret Ujung Nada (Note): Ubah ukuran nada (notes) tetangga
    Spasi: Putar</system:String>
  <system:String x:Key="tip.notes.zoomx">◀ Gulir di sini untuk memperbesar secara horizontal ▶</system:String>
  <system:String x:Key="tip.notes.zoomy">Gulir di sini untuk memperbesar secara vertikal ▶</system:String>

