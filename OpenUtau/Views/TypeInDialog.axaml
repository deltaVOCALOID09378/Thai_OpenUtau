<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ac="using:OpenUtau.App.Controls"
        mc:Ignorable="d" d:DesignWidth="360"
        x:Class="OpenUtau.App.Views.TypeInDialog"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="TypeInDialog"
        Width="360" MinWidth="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="Button.footer">
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Border Margin="{Binding $parent[Window].WindowDecorationMargin}">
    <StackPanel Margin="12" Spacing="10">

      <!-- ข้อความอธิบาย (code-behind เป็นตัวสั่งแสดง) -->
      <TextBlock Name="Prompt"
                 IsVisible="False"
                 TextWrapping="Wrap"
                 LineHeight="20"/>

      <!-- ช่องกรอก -->
      <ac:WorkspacePanelTextBox Name="TextBox"
                                Classes="workspacePanelTextBox"
                                HorizontalAlignment="Stretch"
                                AcceptsReturn="False"/>

      <!-- ปุ่ม -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="8" Margin="0,2,0,0">
        <Button Name="OkButton" Classes="footer accent"
                Content="{DynamicResource button.ok}"
                IsDefault="True"/>
        <Button Name="CancelButton" Classes="footer"
                Content="{DynamicResource button.cancel}"
                IsCancel="True"/>
      </StackPanel>

    </StackPanel>
  </Border>
</Window>