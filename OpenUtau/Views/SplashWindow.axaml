<!-- ============================================================================ -->
<!-- วัน/เดือน/ปี: 29 ตุลาคม 2569 (2026-10-29) -->
<!-- ชื่อไฟล์: SplashWindow.axaml -->
<!-- ลำดับเวอร์ชัน: 1.8 -->
<!-- เครดิตผู้สร้าง: Made And Checked By DELTA SYNTH & All Code Agentic AI Engine [ Original by OpenUtau Authors ] -->
<!-- ตำแหน่งที่จัดวาง: OpenUtau/Views/SplashWindow.axaml -->
<!-- รายละเอียดการแก้ไขงาน: ปรับสัดส่วนหน้าต่าง (Width=520, Height=290) รองรับภาพ Logotype ตัวอักษรแบบใหม่ 2 บรรทัด (THAI OPENUTAU UI / DELTA SYNTH EDITION) จัดวางองค์ประกอบทุกส่วนให้สมดุล เรียบหรู และคมชัดตามมาตรฐาน DELTA SYNTH -->
<!-- ============================================================================ -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="520" Height="290"
        x:Class="OpenUtau.App.Views.SplashWindow"
        Title="Thai OpenUtau by DELTA SYNTH"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        CanResize="False"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
  <Border Background="{DynamicResource WorkspaceCanvasBrush}"
          BorderBrush="#CC2200" 
          BorderThickness="1.5" 
          CornerRadius="12" 
          BoxShadow="0 14 36 0 #80000000"
          ClipToBounds="True">
    <Grid RowDefinitions="*,Auto,Auto,Auto" Margin="28,22,28,18">
      <!-- ส่วนแสดงอัตลักษณ์แบรนด์: โลโก้และ Logotype จัดวางกึ่งกลางอย่างสง่างาม -->
      <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Image Width="92" Height="92" HorizontalAlignment="Center"
               Source="/Assets/Thai OpenUtau Logo.png"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>
        <Panel HorizontalAlignment="Center">
          <Image x:Name="LogoTypeDark" Height="52"
                 Source="/Assets/logotype-w.png" IsVisible="{Binding IsDarkMode}"
                 RenderOptions.BitmapInterpolationMode="HighQuality"/>
          <Image x:Name="LogoTypeLight" Height="52"
                 Source="/Assets/logotype.png" IsVisible="{Binding !IsDarkMode}"
                 RenderOptions.BitmapInterpolationMode="HighQuality"/>
        </Panel>
      </StackPanel>

      <!-- แถบแสดงสถานะข้อความและเปอร์เซ็นต์ความคืบหน้า -->
      <Grid Grid.Row="1" Margin="4,16,4,8" ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Grid.Column="0"
                   Text="กำลังเริ่มต้นระบบ... (Initializing...)"
                   FontFamily="Leelawadee UI, Microsoft Sans Serif, Segoe UI, sans-serif"
                   FontSize="12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="PercentText" Grid.Column="1"
                   Text="0%"
                   FontFamily="Leelawadee UI, Microsoft Sans Serif, Segoe UI, sans-serif"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Foreground="#CC2200"
                   VerticalAlignment="Center"/>
      </Grid>

      <!-- แถบประมวลผลความคืบหน้า (Progress Bar) มาตรฐานสี DELTA SYNTH Red -->
      <ProgressBar x:Name="InitProgressBar" Grid.Row="2"
                   Height="4" HorizontalAlignment="Stretch"
                   Minimum="0" Maximum="100" Value="0"
                   IsIndeterminate="False"
                   Foreground="#CC2200"
                   Background="#2A2A2A"
                   CornerRadius="2"/>

      <!-- ข้อมูลเครดิตท้ายหน้าต่างระดับสตูดิโอ -->
      <Grid Grid.Row="3" Margin="4,12,4,0" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="ADVANCED THAI VOCAL SYNTHESIS ENGINE"
                   FontFamily="Leelawadee UI, Microsoft Sans Serif, Segoe UI, sans-serif"
                   FontSize="9.5"
                   LetterSpacing="1"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   Opacity="0.5"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="DELTA SYNTH EDITION"
                   FontFamily="Leelawadee UI, Microsoft Sans Serif, Segoe UI, sans-serif"
                   FontWeight="SemiBold"
                   FontSize="9.5"
                   LetterSpacing="1"
                   Foreground="#CC2200"
                   Opacity="0.8"
                   VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</Window>
