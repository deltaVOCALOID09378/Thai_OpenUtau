<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="400" Height="200"
        x:Class="OpenUtau.App.Views.SplashWindow"
        Title="SplashWindow"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        CanResize="False"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- App Logo Icon -->
    <Image Margin="20" Width="96" Height="96"
           VerticalAlignment="Top" HorizontalAlignment="Center"
           Source="/Assets/Thai OpenUtau Logo.ico"/>
    <!-- Dark Mode Logotype (shown when IsDarkMode=true) -->
    <Image x:Name="LogoTypeDark" Height="16" Margin="0,136,0,28"
           VerticalAlignment="Top" HorizontalAlignment="Center"
           Source="/Assets/LogoTypeDark.png"
           IsVisible="{Binding IsDarkMode}"/>
    <!-- Light Mode Logotype (shown when IsDarkMode=false) -->
    <Image x:Name="LogoTypeLight" Height="16" Margin="0,136,0,28"
           VerticalAlignment="Top" HorizontalAlignment="Center"
           Source="/Assets/logotype.png"
           IsVisible="{Binding !IsDarkMode}"/>
    <!-- DELTA SYNTH Edition branding subtitle -->
    <TextBlock Text="DELTA SYNTH Edition"
               Margin="0,158,0,10"
               VerticalAlignment="Top" HorizontalAlignment="Center"
               FontSize="12" Opacity="0.80"/>
    <ProgressBar VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
           IsIndeterminate="True"/>
  </Grid>
</Window>
