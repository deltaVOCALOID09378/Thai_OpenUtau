 * เครดิตผู้สร้าง: Made And Checked By DELTA SYNTH & All Code Agentic AI Engine [ Original by OpenUtau Authors ]
 * ตำแหน่งไฟล์: OpenUtau.App/Views/UpdaterDialog.axaml
 * รายละเอียดการแก้ไขงาน: ปรับสถาปัตยกรรม UI สู่ One-pass rendering ฝังโทนสีและฟอนต์ระดับราก ลดภาระ CPU และเพิ่มความเสถียร
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.UpdaterDialog"
        Width="460" Height="400" CanResize="False" WindowStartupLocation="CenterScreen"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource updater.caption}" Closing="OnClosing"
        FontFamily="Leelawadee UI, sans-serif"
        Background="#1A1A1A" Foreground="#F0F0F0">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#333333"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#444444"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#CC2200"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF4422"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
  </Window.Styles>

  <Border BorderBrush="#CC2200" BorderThickness="1" CornerRadius="8" Margin="12" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="20,16,20,16">
      <!-- ไอคอนโปรแกรม -->
      <Image Grid.Row="0" Margin="0,4,0,10" Width="80" Height="80"
             VerticalAlignment="Center" HorizontalAlignment="Center"
             Source="/Assets/Thai OpenUtau Logo.ico"
             RenderOptions.BitmapInterpolationMode="HighQuality"/>

      <!-- Logotype ตัวอักษรแบรนด์ -->
      <Panel Grid.Row="1" Margin="0,0,0,12" HorizontalAlignment="Center">
        <Image Height="44" Source="/Assets/logotype.png" IsVisible="{Binding !IsDarkMode}"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>
        <Image Height="44" Source="/Assets/logotype-w.png" IsVisible="{Binding IsDarkMode}"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>
      </Panel>

      <!-- เวอร์ชันของโปรแกรม -->
      <TextBlock Grid.Row="2" Margin="0,0,0,8" TextAlignment="Center"
                 FontWeight="SemiBold" FontSize="13"
                 Foreground="#B3B3B3"
                 Text="{Binding AppVersion}"/>

      <!-- รายละเอียดการอัปเดต -->
      <TextBlock Grid.Row="3" Margin="10,0,10,12" TextAlignment="Center" TextWrapping="Wrap"
                 FontSize="12" VerticalAlignment="Center"
                 Text="{DynamicResource updater.description}"/>

      <!-- สถานะการตรวจสอบ / ดาวน์โหลดอัปเดต -->
      <TextBlock Grid.Row="4" Margin="10,0,10,16" TextAlignment="Center"
                 Text="{Binding UpdaterStatus}" FontWeight="Bold" FontSize="12.5"
                 Foreground="#CC2200"/>

      <!-- ปุ่มดำเนินการ -->
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
        <Button Width="130" Height="32" Content="{DynamicResource updater.github}" Command="{Binding OnGithub}"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Button Width="130" Height="32" Content="{DynamicResource updater.update}" Command="{Binding OnUpdate}"
                IsEnabled="{Binding UpdateAvailable}" Classes="accent"
                FontWeight="{Binding UpdateButtonFontWeight}"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>