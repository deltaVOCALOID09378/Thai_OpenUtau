<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320"
        x:Class="OpenUtau.App.Views.SliderDialog"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="SliderDialog"
        Width="320" MinWidth="280" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="TextBlock.value">
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.footer">
      <Setter Property="MinWidth" Value="100"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Border Margin="{Binding $parent[Window].WindowDecorationMargin}">
    <StackPanel Margin="12" Spacing="12">

      <!-- แถว Slider + ค่าตัวเลข -->
      <StackPanel Orientation="Horizontal" Spacing="10"
                  HorizontalAlignment="Center">
        <Slider Name="Slider" Width="180"
                Classes="fader"
                TickPlacement="None"
                IsSnapToTickEnabled="True"
                Minimum="0" Maximum="100" TickFrequency="1"
                ValueChanged="OnSliderValueChanged"/>
        <TextBlock Name="TextBlock" Classes="value"/>
      </StackPanel>

      <!-- ปุ่ม OK -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <Button Name="OkButton" Classes="footer accent"
                Content="{DynamicResource button.ok}"
                IsDefault="True"
                Click="OkButtonClick"/>
      </StackPanel>

    </StackPanel>
  </Border>
</Window>