<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        xmlns:c="clr-namespace:OpenUtau.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
        x:Class="OpenUtau.App.Views.SingersDialog"
        x:DataType="vm:SingersViewModel"
        x:CompileBindings="True"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource singers.caption}"
        Width="1180" Height="740" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

  <Window.Styles>
    <!-- กล่องคีย์ลัด -->
    <Style Selector="Border.keybadge">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
      <Setter Property="Padding" Value="5,1"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <!-- ปุ่มในแถบท้าย -->
    <Style Selector="Button.inline">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ปุ่มเครื่องมือแก้ไข Oto สำเร็จรูป -->
    <Style Selector="Button.otobtn">
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.otobtn-accent">
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush1}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush1Foreground}"/>
    </Style>
  </Window.Styles>

  <Border Margin="{Binding $parent[Window].WindowDecorationMargin}">
    <DockPanel Margin="12" LastChildFill="True">

            <!-- =========================== -->
      <!-- ส่วนท้าย: แผงควบคุมและแก้ไข Oto สำเร็จรูปครบวงจร -->
      <!-- =========================== -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="6">

        <!-- แถวที่ 1: แถบเครื่องมือตั้งค่า Oto (1-5) และพรีเซ็ตสำเร็จรูป (Auto, CV, VCV, Copy, Paste, Save) -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <WrapPanel Grid.Column="0" Orientation="Horizontal">
            <!-- ปุ่มคีย์ลัดกำหนดจุด 1-5 -->
            <Button Classes="otobtn" Click="OnSetOffsetClick" ToolTip.Tip="Offset [1]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="1" FontWeight="Bold"/></Border>
                <TextBlock Text="{DynamicResource oto.edit.offset}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnSetOverlapClick" ToolTip.Tip="Overlap [2]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="2" FontWeight="Bold"/></Border>
                <TextBlock Text="{DynamicResource oto.edit.overlap}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnSetPreutterClick" ToolTip.Tip="Preutter [3]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="3" FontWeight="Bold"/></Border>
                <TextBlock Text="{DynamicResource oto.edit.preutter}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnSetFixedClick" ToolTip.Tip="Fixed/Consonant [4]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="4" FontWeight="Bold"/></Border>
                <TextBlock Text="{DynamicResource oto.edit.consonant}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnSetCutoffClick" ToolTip.Tip="Cutoff [5]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="5" FontWeight="Bold"/></Border>
                <TextBlock Text="{DynamicResource oto.edit.cutoff}"/>
              </StackPanel>
            </Button>

            <Separator Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,8,0"/>

            <!-- ปุ่มพรีเซ็ตสำเร็จรูปพิเศษเฉพาะ DELTA SYNTH -->
            <Button Classes="otobtn-accent" Click="OnAutoDetectClick" ToolTip.Tip="Smart Speech Onset Detection">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="⚡" FontSize="11"/>
                <TextBlock Text="{DynamicResource singers.editoto.autodetect}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnApplyCvPresetClick" ToolTip.Tip="CV Preset (Ovl 50, Pre 100, Fix 150)">
              <TextBlock Text="{DynamicResource singers.editoto.presetcv}"/>
            </Button>
            <Button Classes="otobtn" Click="OnApplyVcvPresetClick" ToolTip.Tip="VCV Preset (Ovl 100, Pre 200, Fix 300)">
              <TextBlock Text="{DynamicResource singers.editoto.presetvcv}"/>
            </Button>

            <Separator Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,8,0"/>

            <!-- ปุ่ม Copy / Paste / Save -->
            <Button Classes="otobtn" Click="OnCopyTimingClick" ToolTip.Tip="Copy Timing [Ctrl+C]">
              <TextBlock Text="{DynamicResource singers.editoto.copytiming}"/>
            </Button>
            <Button Classes="otobtn" Click="OnPasteTimingClick" ToolTip.Tip="Paste Timing [Ctrl+V]">
              <TextBlock Text="{DynamicResource singers.editoto.pastetiming}"/>
            </Button>
            <Button Classes="otobtn" Click="OnSaveOtosClick" ToolTip.Tip="Save Otos [Ctrl+S]" IsEnabled="{Binding Singer.OtoDirty}">
              <TextBlock Text="{DynamicResource singers.editoto.save}"/>
            </Button>
          </WrapPanel>

          <!-- ตัวแสดงเวลา Cursor Position เรียลไทม์ -->
          <Border Grid.Column="2" Classes="keybadge" Padding="8,3" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Time:" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11"/>
              <TextBlock x:Name="CursorTimeText" Text="0.0 ms" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource AccentBrush1}"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- แถวที่ 2: การเลื่อนดูและซูม (Q/E, W/S, A/D, F) + ปุ่มเล่นไฟล์ + โหมด Mel Spectrogram -->
        <Grid ColumnDefinitions="*,Auto">
          <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- ย้ายไปยัง Oto ก่อนหน้า/ถัดไป -->
            <Button Classes="otobtn" Click="OnPrevOtoClick" ToolTip.Tip="Previous Oto [Q]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="Q"/></Border>
                <TextBlock Text="{DynamicResource singers.otoview.selectprev}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnNextOtoClick" ToolTip.Tip="Next Oto [E]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="E"/></Border>
                <TextBlock Text="{DynamicResource singers.otoview.selectnext}"/>
              </StackPanel>
            </Button>

            <Separator Width="1" Height="18" Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,8,0"/>

            <!-- การซูมและการเลื่อนคลื่นเสียง -->
            <Button Classes="otobtn" Click="OnShowAllClick" ToolTip.Tip="Show All [F]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="F"/></Border>
                <TextBlock Text="{DynamicResource singers.otoview.showall}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnZoomInClick" ToolTip.Tip="Zoom In [W]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="W"/></Border>
                <TextBlock Text="{DynamicResource singers.otoview.zoomin}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnZoomOutClick" ToolTip.Tip="Zoom Out [S]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="S"/></Border>
                <TextBlock Text="{DynamicResource singers.otoview.zoomout}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnPanLeftClick" ToolTip.Tip="Pan Left [A]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="A"/></Border>
                <TextBlock Text="{DynamicResource singers.otoview.moveleft}"/>
              </StackPanel>
            </Button>
            <Button Classes="otobtn" Click="OnPanRightClick" ToolTip.Tip="Pan Right [D]">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="keybadge"><TextBlock Text="D"/></Border>
                <TextBlock Text="{DynamicResource singers.otoview.moveright}"/>
              </StackPanel>
            </Button>
          </WrapPanel>

          <!-- ปุ่มเล่นเสียง [Space] + สวิตช์ Mel Spectrogram ขวาสุด -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Border BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
              <Button Classes="inline" Background="Transparent" Click="OnPlaySelectedFile" ToolTip.Tip="Play/Stop [Space]">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Viewbox Width="14" Height="14">
                    <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Data="M 0 0 L 7 6.5 L 0 13 Z"/>
                  </Viewbox>
                  <TextBlock Text="{DynamicResource singers.playselectedfile}"/>
                </StackPanel>
              </Button>
            </Border>
            <Border BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
              <ToggleButton Classes="inline" Background="Transparent" IsChecked="{Binding ZoomInMel}" ToolTip.Tip="Mel Spectrogram Zoom">
                <Viewbox Width="14" Height="14">
                  <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
                </Viewbox>
              </ToggleButton>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- =========================== -->
      <!-- เนื้อหาหลัก -->
      <!-- =========================== -->
      <Grid DockPanel.Dock="Top">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="2*"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" MinWidth="300"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- ***** แถว 0: ข้อมูลนักร้อง ***** -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8"
              ColumnDefinitions="Auto,8,*">
          <!-- อวาตาร์ -->
          <!-- รูปภาพนักร้อง (Avatar & Full-Body Portrait) -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <Border Width="100" Height="100" CornerRadius="8" ClipToBounds="True"
                    BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    ToolTip.Tip="รูปโปรไฟล์หัวแทร็ก (Profile Icon)">
              <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
            </Border>
            <Border Width="65" Height="100" CornerRadius="8" ClipToBounds="True"
                    BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    ToolTip.Tip="รูปเต็มตัว (Full-Body Portrait)">
              <Image Source="{Binding Portrait}" Stretch="Uniform"/>
            </Border>
          </StackPanel>

          <!-- ส่วนข้อมูล -->
          <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="4">
            <ComboBox x:Name="name" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Singers}"
                      SelectedItem="{Binding Singer}"
                      SelectionChanged="OnSelectedSingerChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding LocalizedName}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <ScrollViewer MaxHeight="90">
              <TextBlock x:Name="info" TextWrapping="Wrap"
                         Text="{Binding Info}"/>
            </ScrollViewer>

            <!-- ปุ่มล่างของฝั่งซ้าย -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="{DynamicResource singers.location}"
                      IsEnabled="{Binding Singer, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenLocation}" Padding="12,4"/>

              <Button Background="Transparent" Padding="4"
                      IsEnabled="{Binding Singer, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Click="OnSingerMenuButton">
                <Viewbox Width="18" Height="18">
                  <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                </Viewbox>
                <Button.ContextMenu>
                  <ContextMenu Name="SingerMenu" Placement="Bottom">
                    <MenuItem Header="{DynamicResource singers.visitwebsite}" Click="OnVisitWebsite" IsEnabled="{Binding HasWebsite}"/>
                    <MenuItem Header="{DynamicResource singers.setimage}" Click="OnSetImage"/>
                    <MenuItem Header="{DynamicResource singers.setportrait}" Click="OnSetPortrait"/>
                    <MenuItem Header="{DynamicResource singers.syncpictures}" Click="OnSyncPictures"/>
                    <MenuItem Header="{DynamicResource singers.setencoding}" ItemsSource="{Binding SetEncodingMenuItems}" Classes="MenuItemWithSubMenu"/>
                    <MenuItem Header="{DynamicResource singers.setsingertype}" ItemsSource="{Binding SetSingerTypeMenuItems}" Classes="MenuItemWithSubMenu"/>
                    <MenuItem Header="{DynamicResource singers.setdefaultphonemizer}" ItemsSource="{Binding SetDefaultPhonemizerMenuItems}" Classes="MenuItemWithSubMenu"/>
                    <MenuItem Header="{DynamicResource singers.usefilename}" IsVisible="{Binding IsClassic}" Click="OnSetUseFilenameAsAlias">
                      <MenuItem.Icon>
                        <CheckBox Classes="menu" IsChecked="{Binding UseFilenameAsAlias}"/>
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource singers.publish}" Click="OnPublish"/>
                    <MenuItem Header="{DynamicResource singers.merge}" IsVisible="{Binding IsClassic}" Click="OnMerge"/>
                    <MenuItem Header="{DynamicResource singers.errorreport}" Command="{Binding ErrorReport}"/>
                    <MenuItem Header="{DynamicResource singers.refresh}" Command="{Binding Refresh}"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>

              <c:WorkspacePanelTextBox Text="{Binding SearchAlias}" Classes="workspacePanelTextBox"
                                       Watermark="{DynamicResource singers.editoto.searchalias}"
                                       MinWidth="160" HorizontalAlignment="Stretch" Focusable="True"
                                       IsVisible="{Binding UseSearchAlias}"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Sub-bands DataGrid (คอลัมน์ขวาบน) -->
        <DataGrid Grid.Row="0" Grid.Column="2" CanUserSortColumns="False"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  ItemsSource="{Binding Subbanks}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource oto.prefix}" Binding="{Binding Prefix}"/>
            <DataGridTextColumn Header="{DynamicResource oto.suffix}" Binding="{Binding Suffix}"/>
            <DataGridTextColumn Header="{DynamicResource singers.subbanks.toneranges}" Binding="{Binding ToneRangesString}"/>
            <DataGridTextColumn Header="{DynamicResource singers.subbanks.color}" Binding="{Binding Color}"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- ***** แถว 1: ปุ่มล่างของส่วนหัว (อ่าน Readme, Play Sample, Reset/Save, Edit Sub-bands) ***** -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
          <Button Margin="0" Padding="12,4"
                  Content="{DynamicResource singers.readme}"
                  Click="OnOpenReadme"/>
          <Button Margin="0" Padding="12,4"
                  Content="{DynamicResource singers.playsample}"
                  Click="OnPlayCharacterSample"/>

          <Separator Width="1" Height="24"
                     Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                     Margin="8,0"/>

          <Button Margin="0" Padding="10,4"
                  Content="{DynamicResource singers.editoto.reset}"
                  Command="{Binding RefreshSinger}"
                  IsVisible="{Binding IsClassic}"
                  IsEnabled="{Binding Singer.OtoDirty}"/>
          <Button Margin="0" Padding="10,4"
                  Content="{DynamicResource singers.editoto.save}"
                  Command="{Binding SaveOtos}"
                  IsVisible="{Binding IsClassic}"
                  IsEnabled="{Binding Singer.OtoDirty}"/>
          <Button Margin="0" Padding="10,4"
                  Content="{DynamicResource singers.editoto.editinvlabeler}"
                  IsVisible="{Binding IsClassic}"
                  Click="OnEditInVLabeler"/>

          <Separator Width="1" Height="24"
                     Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                     Margin="8,0"/>

          <Button Margin="0" Padding="10,4"
                  Content="{DynamicResource singers.subbanks.edit}"
                  Click="OnEditSubbanksButton"
                  IsEnabled="{Binding Singer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>

        <!-- ***** Splitter 1 ***** -->
        <GridSplitter Grid.Row="2" Grid.ColumnSpan="3"
                      Height="8" Background="Transparent"/>

        <!-- ***** แถว 3: Oto Grid ***** -->
        <DataGrid Name="OtoGrid" Grid.Row="3" Grid.ColumnSpan="3"
                  CanUserResizeColumns="True" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  ItemsSource="{Binding DisplayedOtos}"
                  SelectedItem="{Binding SelectedOto}"
                  SelectedIndex="{Binding SelectedIndex}"
                  SelectionChanged="OnSelectedOtoChanged"
                  BeginningEdit="OnBeginningEdit"
                  CellEditEnded="OnCellEditEnded">
          <DataGrid.ContextMenu>
            <ContextMenu IsVisible="{Binding IsClassic}">
              <MenuItem Header="{DynamicResource singers.editoto.gotosource}" Click="GotoSourceFile"/>
              <MenuItem Header="{DynamicResource singers.editoto.editinvlabeler}" Click="GotoVLabelerOto"/>
              <MenuItem Header="{DynamicResource singers.editoto.editinsetparam}" Click="GotoSetParamOto"/>
              <MenuItem Header="{DynamicResource singers.editoto.regenfrq}">
                <MenuItem Header="HARVEST" Click="RegenFrq" Tag="harvest"/>
                <MenuItem Header="DIO" Click="RegenFrq" Tag="dio"/>
                <MenuItem Header="pYIN" Click="RegenFrq" Tag="pyin"/>
                <MenuItem Header="CREPE" Click="RegenFrq" Tag="crepe"/>
              </MenuItem>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource oto.alias}" Binding="{Binding Alias}" IsReadOnly="True"/>
            <DataGridTextColumn Header="{DynamicResource oto.set}" Binding="{Binding Set}" IsReadOnly="True"/>
            <DataGridTextColumn Header="{DynamicResource oto.file}" Binding="{Binding DisplayFile}" IsReadOnly="True"/>
            <DataGridTextColumn Header="{DynamicResource oto.phonetic}" Binding="{Binding Phonetic}" IsReadOnly="True"/>
            <DataGridTextColumn Header="{DynamicResource oto.prefix}" Binding="{Binding Prefix}" IsReadOnly="True"/>
            <DataGridTextColumn Header="{DynamicResource oto.suffix}" Binding="{Binding Suffix}" IsReadOnly="True"/>
            <DataGridTextColumn Header="{DynamicResource oto.color}" Binding="{Binding Color}" IsReadOnly="True"/>
            <DataGridTextColumn Header="{DynamicResource oto.offset}" Binding="{Binding Offset}"/>
            <DataGridTextColumn Header="{DynamicResource oto.consonant}" Binding="{Binding Consonant}"/>
            <DataGridTextColumn Header="{DynamicResource oto.cutoff}" Binding="{Binding Cutoff}"/>
            <DataGridTextColumn Header="{DynamicResource oto.preutter}" Binding="{Binding Preutter}"/>
            <DataGridTextColumn Header="{DynamicResource oto.overlap}" Binding="{Binding Overlap}"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- ***** Splitter 2 ***** -->
        <GridSplitter Grid.Row="4" Grid.ColumnSpan="3"
                      Height="8" Background="Transparent"/>

        <!-- ***** แถว 5: OtoPlot ***** -->
        <Border Grid.Row="5" Grid.ColumnSpan="3"
                BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Padding="2">
          <c:OtoPlot Name="OtoPlot" ZoomInMel="{Binding ZoomInMel}">
            <c:OtoPlot.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{DynamicResource oto.edit.offset}" InputGesture="1" Click="OnSetOffsetClick"/>
                <MenuItem Header="{DynamicResource oto.edit.overlap}" InputGesture="2" Click="OnSetOverlapClick"/>
                <MenuItem Header="{DynamicResource oto.edit.preutter}" InputGesture="3" Click="OnSetPreutterClick"/>
                <MenuItem Header="{DynamicResource oto.edit.consonant}" InputGesture="4" Click="OnSetFixedClick"/>
                <MenuItem Header="{DynamicResource oto.edit.cutoff}" InputGesture="5" Click="OnSetCutoffClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource singers.editoto.autodetect}" Click="OnAutoDetectClick"/>
                <MenuItem Header="{DynamicResource singers.editoto.presetcv}" Click="OnApplyCvPresetClick"/>
                <MenuItem Header="{DynamicResource singers.editoto.presetvcv}" Click="OnApplyVcvPresetClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource singers.editoto.copytiming}" InputGesture="Ctrl+C" Click="OnCopyTimingClick"/>
                <MenuItem Header="{DynamicResource singers.editoto.pastetiming}" InputGesture="Ctrl+V" Click="OnPasteTimingClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource singers.editoto.save}" InputGesture="Ctrl+S" Click="OnSaveOtosClick"/>
                <MenuItem Header="{DynamicResource singers.playselectedfile}" InputGesture="Space" Click="OnPlaySelectedFile"/>
              </ContextMenu>
            </c:OtoPlot.ContextMenu>
          </c:OtoPlot>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>