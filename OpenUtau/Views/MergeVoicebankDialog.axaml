 * ตำแหน่งไฟล์: OpenUtau.App/Views/MergeVoicebankDialog.axaml
 * รายละเอียดการแก้ไข: อัปเกรดความเสถียรของหน้าต่าง จัดระเบียบ DataGrid และฝังโทนสีมาตรฐานองค์กรเพื่อความรวดเร็วในการเรนเดอร์
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        mc:Ignorable="d" Width="600" Height="400" MinWidth="600" MinHeight="400"
        x:Class="OpenUtau.App.Views.MergeVoicebankDialog"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource mergevoicebank.title}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="False"
        FontFamily="Leelawadee UI, sans-serif"
        Background="#1A1A1A" Foreground="#F0F0F0">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#CC2200"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF4422"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#991100"/>
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="BorderBrush" Value="#444444"/>
    </Style>
  </Window.Styles>
  <Carousel SelectedIndex="{Binding Step}" Margin="{Binding $parent.WindowDecorationMargin}">
    <!-- Select which voicebank to merge -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="60"/>
        <RowDefinition Height="1*"/>
        <RowDefinition Height="40"/>
      </Grid.RowDefinitions>
      <TextBlock Margin="10" Text="{DynamicResource mergevoicebank.selectsinger}" VerticalAlignment="Center"/>
      <ComboBox Margin="10" Grid.Row="1" Width="240" ItemsSource="{Binding Voicebanks}" SelectedItem="{Binding OtherSinger}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Grid Grid.Row="2" Margin="10" HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
          <Button Margin="0" Command="{Binding Next}" MinWidth="80"
                  Content="{DynamicResource mergevoicebank.next}"/>
        </StackPanel>
      </Grid>
    </Grid>
    <!-- Edit folder names -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="2*"/>
        <RowDefinition Height="1*"/>
        <RowDefinition Height="40"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="10" Text="{DynamicResource mergevoicebank.setfolder}" VerticalAlignment="Center"/>
      <DataGrid Grid.Row="1" Margin="10" HorizontalAlignment="Stretch" CanUserResizeColumns="True" 
                ItemsSource="{Binding FolderRenames}" CellEditEnded="OnEditedFolder">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Original Name" Binding="{Binding Name}" IsReadOnly="True"/>
          <DataGridTextColumn Header="New Name" Binding="{Binding NewName}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" Margin="10" Text="{Binding FolderNameErrors}" Foreground="#FF4422"/>
      <Grid Grid.Row="3" Margin="10" HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
          <Button Margin="0" Command="{Binding Next}" MinWidth="80"
                  Content="{DynamicResource mergevoicebank.next}"/>
        </StackPanel>
      </Grid>
    </Grid>
    <!-- Edit Suffixes -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="2*"/>
        <RowDefinition Height="1*"/>
        <RowDefinition Height="40"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="10" Text="{DynamicResource mergevoicebank.setsubbank}" VerticalAlignment="Center"/>
      <DataGrid Grid.Row="1" Margin="10" HorizontalAlignment="Stretch" CanUserResizeColumns="True"
                ItemsSource="{Binding SubbankRenames}" CellEditEnded="OnEditedSubbank">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Original subbank" Binding="{Binding Name}" IsReadOnly="True"/>
          <DataGridTextColumn Header="New subbank" Binding="{Binding NewName}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" Margin="10" Text="{Binding SubbankNameErrors}" Foreground="#FF4422"/>
      <Grid Grid.Row="3" Margin="10" HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
          <Button Margin="0" Command="{Binding Next}" MinWidth="80"
                  Content="{DynamicResource mergevoicebank.next}"/>
        </StackPanel>
      </Grid>
    </Grid>
    <!-- Edit Voice color names -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="2*"/>
        <RowDefinition Height="1*"/>
        <RowDefinition Height="40"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="10" Text="{DynamicResource mergevoicebank.setvoicecolor}" VerticalAlignment="Center"/>
      <DataGrid Grid.Row="1" Margin="10" HorizontalAlignment="Stretch" CanUserResizeColumns="True"
                ItemsSource="{Binding VoiceColorRenames}"  CellEditEnded="OnEditedVoiceColor">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Original name" Binding="{Binding Name}" IsReadOnly="True"/>
          <DataGridTextColumn Header="New name" Binding="{Binding NewName}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" Margin="10" Text="{Binding VoiceColorNameErrors}" Foreground="#FF4422"/>
      <Grid Grid.Row="3" Margin="10" HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
          <TextBlock Margin="0,0,10,0" Text="{DynamicResource mergevoicebank.voicebank.prompt}" VerticalAlignment="Center"/>
          <Button Margin="0" Click="MergeClicked" MinWidth="80"
                  Content="{DynamicResource mergevoicebank.merge}"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Carousel>
</Window>