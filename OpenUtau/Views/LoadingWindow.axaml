<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="240"
        x:Class="OpenUtau.App.Views.LoadingWindow" SizeToContent="WidthAndHeight" CanResize="False"
        Title="Thai OpenUtau Loading" MinWidth="380" MinHeight="200"
        Icon="/Assets/Thai OpenUtau Logo.ico" 
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="BorderOnly"
        Background="Transparent"
        FontFamily="Leelawadee UI, Leelawadee, sans-serif">

<!-- กรอบหลักออกแบบใหม่ให้ดูลึกและเรียบหรูขึ้น -->
<Border Background="#1A1A1A" 
        BorderBrush="#CC2200" 
        BorderThickness="1" 
        CornerRadius="16" 
        Padding="40,30,40,25"
        BoxShadow="0 12 40 0 #C0000000">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto">
        <!-- ปุ่มกากบาท (X) ปิดหน้าต่างป๊อปอัพที่มุมขวาบน -->
        <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="28" Height="28" Background="Transparent" BorderThickness="0"
                Margin="0,-15,-25,0" Cursor="Hand" Click="OnCloseButtonClick"
                ToolTip.Tip="ปิดหน้าต่างโหลด / Dismiss Loading">
            <Button.Styles>
                <Style Selector="Button:pointerover">
                    <Setter Property="Background" Value="#33FF4422"/>
                </Style>
            </Button.Styles>
            <Path Data="M 6.4 5 L 5 6.4 L 10.6 12 L 5 17.6 L 6.4 19 L 12 13.4 L 17.6 19 L 19 17.6 L 13.4 12 L 19 6.4 L 17.6 5 L 12 10.6 Z"
                  Fill="#F0F0F0" Stretch="Uniform" Width="11" Height="11"/>
        </Button>
        
        <!-- โลโก้แบรนด์ (ปรับให้เรนเดอร์ภาพคมชัดสูง) -->
        <Image Grid.Row="0" Margin="0,0,0,20" Width="96" Height="96"
               VerticalAlignment="Center" HorizontalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Source="/Assets/Thai OpenUtau Logo.ico"/>
        
        <!-- ข้อความสถานะหลัก (ปรับน้ำหนักฟอนต์ให้ดูโมเดิร์น) -->
        <TextBlock Grid.Row="1" Name="Text" 
                   Foreground="#F0F0F0" 
                   FontSize="16" 
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" 
                   MaxWidth="320" 
                   Margin="0,0,0,20"
                   TextAlignment="Center">
            กำลังโหลดระบบ... / Loading...
        </TextBlock>
        
        <!-- แถบประมวลผล (ปรับพื้นหลังแถบให้กลืนกับ UI มากขึ้น) -->
        <ProgressBar Grid.Row="2" 
                     IsIndeterminate="True" 
                     Foreground="#CC2200" 
                     Background="#2A2A2A" 
                     Height="4" 
                     Margin="0,0,0,20" 
                     Width="280" 
                     CornerRadius="2"/>
                     
        <!-- ข้อความลิขสิทธิ์องค์กร (ใช้ตัวพิมพ์ใหญ่และช่องไฟเพื่อความพรีเมียม) -->
        <TextBlock Grid.Row="3"
                   Foreground="#808080" 
                   FontSize="11" 
                   FontWeight="Regular"
                   TextAlignment="Center"
                   LetterSpacing="1"
                   Opacity="0.6">
            THAI OPENUTAU BY DELTA SYNTH
        </TextBlock>
        
    </Grid>
</Border>
</Window>