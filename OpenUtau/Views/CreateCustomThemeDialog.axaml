<!-- วัน/เดือน/ปี: 21 ตุลาคม 2569 (2026-10-21) -->
<!-- ชื่อไฟล์: CreateCustomThemeDialog.axaml -->
<!-- ลำดับเวอร์ชัน: 1.0 -->
<!-- เครดิตผู้สร้าง: Made And Checked By DELTA SYNTH & All Code Agentic AI Engine [ Original by OpenUtau Authors ] -->
<!-- ตำแหน่งที่จัดวาง: OpenUtau/Views/CreateCustomThemeDialog.axaml -->
<!-- รายละเอียดการแก้ไขงาน: ปรับปรุง UI หน้าต่างสร้างธีมแบบกำหนดเองให้เป็น Floating Modern Dark Card ตามมาตรฐานองค์กร DELTA SYNTH -->
<!--                       ควบคุมโทนสีแดง-ดำ (#CC2200, #1A1A1A) บังคับใช้ฟอนต์ Leelawadee UI และคง Control Names เดิมครบถ้วน -->
<!-- ============================================================================ -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="using:OpenUtau.App.Controls"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="220"
        x:Class="OpenUtau.App.Views.CreateCustomThemeDialog"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource prefs.appearance.customtheme.create.title}"
        Width="380" Height="220" MinWidth="380" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="Transparent"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="BorderOnly"
        FontFamily="Leelawadee UI, Leelawadee, sans-serif">

  <!-- กรอบหน้าต่างหลักลอยตัว สไตล์ Modern Clean ของ DELTA SYNTH -->
  <Border Background="#1A1A1A"
          BorderBrush="#CC2200"
          BorderThickness="1.5"
          CornerRadius="14"
          Padding="20,18,20,18"
          BoxShadow="0 12 36 0 #A0000000">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">

      <!-- ข้อความแจ้งและคำอธิบายการสร้างธีม -->
      <TextBlock Grid.Row="0"
                 Text="{DynamicResource prefs.appearance.customtheme.create.prompt}"
                 Foreground="#F0F0F0"
                 FontSize="13"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Margin="0,0,0,12"/>

      <!-- ช่องกรอกชื่อธีมใหม่ -->
      <TextBox Grid.Row="1"
               Name="NameBox"
               Height="32"
               VerticalContentAlignment="Center"
               Background="#2A2A2A"
               Foreground="#F0F0F0"
               BorderBrush="#444444"
               BorderThickness="1"
               CornerRadius="6"
               Margin="0,0,0,12"/>

      <!-- เมนูเลือกโครงสร้างธีมตั้งต้น (Base Theme) -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,16" VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Foreground="#CCCCCC"
                   FontSize="12"
                   Text="{DynamicResource prefs.appearance.customtheme.create.base}"/>
        <c:WorkspacePanelComboBox Grid.Column="1"
                                  Name="BaseThemeBox"
                                  Classes="workspacePanelCombo"
                                  HorizontalAlignment="Right"
                                  MinWidth="140"
                                  Height="32"
                                  SelectedIndex="0"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  BorderBrush="#444444"
                                  BorderThickness="1"
                                  CornerRadius="6">
          <ComboBoxItem Content="{DynamicResource prefs.appearance.customtheme.create.baselight}"/>
          <ComboBoxItem Content="{DynamicResource prefs.appearance.customtheme.create.basedark}"/>
        </c:WorkspacePanelComboBox>
      </Grid>

      <!-- ปุ่มกดยืนยันการทำงาน -->
      <Button Grid.Row="3"
              Name="OkButton"
              Content="OK"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Height="34"
              Background="#CC2200"
              Foreground="#F0F0F0"
              FontWeight="Bold"
              CornerRadius="6"
              BorderThickness="0"
              Cursor="Hand"/>

    </Grid>
  </Border>
</Window>