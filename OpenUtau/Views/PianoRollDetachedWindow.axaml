<!-- ตำแหน่งที่จัดวาง: OpenUtau/Views/PianoRollDetachedWindow.axaml -->
<!-- รายละเอียดการแก้ไขงาน: ยกระดับ UI หน้าต่างแยกเปียโนโรลสู่ Floating Modern Dark Card ตามมาตรฐาน DELTA SYNTH -->
<!--                       ควบคุมโทนสีแดง-ดำ (#CC2200, #1A1A1A) บังคับใช้ฟอนต์ Leelawadee UI และคง Control Names เดิมครบ 100% -->
<!-- ============================================================================ -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        xmlns:api="using:OpenUtau.Api"
        xmlns:c="clr-namespace:OpenUtau.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="650"
        x:Class="OpenUtau.App.Views.PianoRollDetachedWindow"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{Binding NotesViewModel.WindowTitle}"
        MinWidth="300" MinHeight="200"
        Width="{Binding Width}" Height="{Binding Height}"
        Focusable="True" GotFocus="WindowGotFocus"
        TransparencyLevelHint="None"
        Background="Transparent"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="BorderOnly"
        FontFamily="Leelawadee UI, Leelawadee, sans-serif"
        Closing="WindowClosing" Deactivated="WindowDeactivated">

  <!-- กรอบหน้าต่างหลักลอยตัว สไตล์ Modern Clean ของ DELTA SYNTH -->
  <Border Background="#1A1A1A"
          BorderBrush="#CC2200"
          BorderThickness="1.5"
          CornerRadius="10"
          ClipToBounds="True">
    <ContentControl Name="PianoRollContainer"/>
  </Border>
</Window>