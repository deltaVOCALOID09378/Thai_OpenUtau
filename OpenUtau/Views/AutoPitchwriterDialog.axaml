<!-- ============================================================================ -->
<!-- 1. วัน/เดือน/ปี พ.ศ. กับ ปี ค.ศ.: 11 พฤศจิกายน 2569 / 11 November 2026 -->
<!-- 2. ชื่อไฟล์: AutoPitchwriterDialog.axaml -->
<!-- 3. ลำดับเวอร์ชัน: 1.5 -->
<!-- 4. รายชื่อเครดิต: Made And Checked By DELTA SYNTH & All Code Agentic AI Engine [ Original by Patiphat Wongyai (Delta) & Gemini AI ] -->
<!-- 5. ตำแหน่งที่จัดวาง: OpenUtau/Views/AutoPitchwriterDialog.axaml -->
<!-- 6. รายละเอียดการแก้ไขงาน: ยกระดับ UI รองรับโหมด Smart Melodic AI, Original Canon Exe, และ 6 Shapes Calibrated -->
<!-- ============================================================================ -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="490" d:DesignHeight="440"
        x:Class="OpenUtau.App.Views.AutoPitchwriterDialog"
        Title="The AutoPitchwriter (DELTA SYNTH Smart Tuning Engine)"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        WindowStartupLocation="CenterOwner"
        Width="490" Height="440" MinWidth="490" MinHeight="440"
        CanResize="False"
        Background="Transparent"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="BorderOnly"
        FontFamily="Leelawadee UI, Leelawadee, sans-serif">

  <Border Background="#1A1A1A" 
          BorderBrush="#CC2200" 
          BorderThickness="1.5" 
          CornerRadius="12" 
          Padding="18">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto">

      <!-- Header -->
      <StackPanel Grid.Row="0" Margin="0,0,0,10" Spacing="3">
        <TextBlock Text="The AutoPitchwriter / กำหนดรูปแบบการจูนเสียงอัตโนมัติ" 
                   FontWeight="Bold" 
                   FontSize="15" 
                   Foreground="#F0F0F0"/>
        <TextBlock Text="เลือกโหมดจูนเสียงอัจฉริยะ โหมดต้นฉบับ Canon หรือปรับแต่งรูปทรงเส้นพิตช์" 
                   FontSize="11" 
                   Foreground="#A0A0A0"/>
      </StackPanel>

      <!-- Tuning Mode Selection -->
      <Border Grid.Row="1" Background="#242424" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#383838" BorderThickness="1">
        <StackPanel Spacing="5">
          <RadioButton Name="rbSmartMode" GroupName="TuningMode" IsChecked="True" 
                       Content="1. Smart Melodic AI / อัจฉริยะเสียงร้องไพเราะ (แนะนำ - ไม่เพี้ยน เกาะคีย์ 100%)" 
                       FontWeight="SemiBold" Foreground="#F0F0F0"/>
          <RadioButton Name="rbOriginalCanon" GroupName="TuningMode" 
                       Content="2. Original Canon Engine / รันโปรแกรม Canon AutoPitchwriter.exe ดั้งเดิม" 
                       Foreground="#D0D0D0"/>
          <RadioButton Name="rbCustomShapes" GroupName="TuningMode" 
                       Content="3. Calibrated Canon Shapes / กำหนด 6 รูปทรงพิตช์ (ไมโครเซนต์สมดุล)" 
                       Foreground="#D0D0D0"/>
        </StackPanel>
      </Border>

      <!-- 6 Shapes Box (for Mode 3 or customization) -->
      <Border Grid.Row="2" Background="#202020" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#333333" BorderThickness="1">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
          <CheckBox Grid.Row="0" Grid.Column="0" Name="chkThunderbolt" 
                    Content="1. Thunderbolt / สายฟ้า (+5c)" 
                    IsChecked="True" Foreground="#F0F0F0" Margin="0,1,0,4"/>
          <CheckBox Grid.Row="0" Grid.Column="1" Name="chkPitchDropRise" 
                    Content="2. Drop/Rise / ช้อน-รูด (-8c)" 
                    IsChecked="True" Foreground="#F0F0F0" Margin="0,1,0,4"/>
          <CheckBox Grid.Row="1" Grid.Column="0" Name="chkSlope" 
                    Content="3. The Slope / สโลป Legato" 
                    IsChecked="True" Foreground="#F0F0F0" Margin="0,1,0,4"/>
          <CheckBox Grid.Row="1" Grid.Column="1" Name="chkWarpShape" 
                    Content="4. W-Shape / คลื่นดับเบิ้ล (±4c)" 
                    IsChecked="True" Foreground="#F0F0F0" Margin="0,1,0,4"/>
          <CheckBox Grid.Row="2" Grid.Column="0" Name="chkUPitchDrop" 
                    Content="5. U-Drop / ดิ่งทอดหาง (-12c)" 
                    IsChecked="True" Foreground="#F0F0F0" Margin="0,1,0,1"/>
          <CheckBox Grid.Row="2" Grid.Column="1" Name="chkPitchDent" 
                    Content="6. Pitch Dent / รอยบุ๋มเน้นคำ (-6c)" 
                    IsChecked="True" Foreground="#F0F0F0" Margin="0,1,0,1"/>
        </Grid>
      </Border>

      <!-- Parameters & Vibrato Toggle -->
      <StackPanel Grid.Row="3" Margin="0,0,0,12" Spacing="8">
        <CheckBox Name="chkNaturalVibrato" IsChecked="True" 
                  Content="เปิดใช้งานลูกคอธรรมชาติ (Natural Vocal Vibrato ~6.0 Hz บนโน้ตยาว)" 
                  Foreground="#F0F0F0" FontSize="11.5"/>

        <Grid ColumnDefinitions="Auto,*,Auto,*">
          <TextBlock Grid.Column="0" Text="Portamento Start (ms):" 
                     VerticalAlignment="Center" Foreground="#D0D0D0" FontSize="11" Margin="0,0,6,0"/>
          <TextBox Grid.Column="1" Name="txtPortamentoStart" Text="-25" Height="26" 
                   VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                   Background="#2A2A2A" Foreground="#F0F0F0" BorderBrush="#444444" CornerRadius="4" Margin="0,0,10,0"/>
          <TextBlock Grid.Column="2" Text="Length (ms):" 
                     VerticalAlignment="Center" Foreground="#D0D0D0" FontSize="11" Margin="0,0,6,0"/>
          <TextBox Grid.Column="3" Name="txtPortamentoLength" Text="50" Height="26" 
                   VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                   Background="#2A2A2A" Foreground="#F0F0F0" BorderBrush="#444444" CornerRadius="4"/>
        </Grid>
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button Content="Default / คืนค่า" Click="OnDefaultClick" Width="120" Height="32" 
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                Background="#333333" Foreground="#F0F0F0" CornerRadius="6" BorderThickness="0" Cursor="Hand"/>
        <Button Content="Run / ทำงาน" Click="OnRunClick" Width="120" Height="32" 
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                Background="#CC2200" Foreground="#F0F0F0" FontWeight="Bold" CornerRadius="6" BorderThickness="0" Cursor="Hand"/>
      </StackPanel>

    </Grid>
  </Border>
</Window>
