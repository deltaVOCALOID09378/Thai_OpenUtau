<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="450"
        x:Class="OpenUtau.App.Views.TrackColorDialog"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource tracks.trackcolor}"
        Width="450" MinWidth="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="Button.footer">
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Border Margin="{Binding $parent[Window].WindowDecorationMargin}">
    <Grid RowDefinitions="Auto,Auto" Margin="12">

      <!-- แผงเลือกสี -->
      <ListBox Grid.Row="0"
               ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem}"
               Background="Transparent"
               Margin="0,0,0,12"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:TrackColorPickerItemViewModel">
            <Panel>
              <Border Background="{Binding Color.AccentColor}"
                      CornerRadius="6"
                      Width="25" Height="25"
                      IsVisible="{Binding !IsCreateTile}">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{DynamicResource prefs.appearance.customtrackcolor.edit}"
                              IsVisible="{Binding IsCustom}"
                              Click="OnContextEditClick"/>
                    <MenuItem Header="{DynamicResource menu.edit.delete}"
                              IsVisible="{Binding IsCustom}"
                              Click="OnContextDeleteClick"/>
                  </ContextMenu>
                </Border.ContextMenu>
              </Border>

              <Panel Width="25" Height="25"
                     IsVisible="{Binding IsCreateTile}"
                     Background="Transparent">
                <Viewbox Width="16" Height="16">
                  <Path Fill="{DynamicResource MutedIconBrush}"
                        Data="M8.43 3.33 a0.38 0.38 0 0 0 -0.38 0.38 v4.35 H3.7 a0.38 0.38 0 0 0 -0.38 0.38 v1.13 c0 0.23 0.19 0.38 0.38 0.38 h4.35 v4.35 c0 0.23 0.19 0.38 0.38 0.38 h1.13 a0.38 0.38 0 0 0 0.38 -0.38 V9.97 h4.35 a0.38 0.38 0 0 0 0.38 -0.38 v-1.13 a0.38 0.38 0 0 0 -0.38 -0.38 H9.97 V3.7 a0.38 0.38 0 0 0 -0.38 -0.38 h-1.13 z"/>
                </Viewbox>
              </Panel>
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="2"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="ToolTip.Tip" Value="{Binding ToolTipName}"/>
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding Color.AccentColorLightSemi}"/>
          </Style>
        </ListBox.Styles>
      </ListBox>

      <!-- ปุ่ม -->
      <StackPanel Grid.Row="1" Orientation="Horizontal"
                  HorizontalAlignment="Center" Spacing="10">
        <Button Classes="footer"
                Content="{DynamicResource button.cancel}"
                IsCancel="True"
                Click="OnCancel"/>
        <Button Classes="footer accent"
                Content="{DynamicResource button.apply}"
                IsDefault="True"
                Click="OnFinish"/>
      </StackPanel>

    </Grid>
  </Border>
</Window>