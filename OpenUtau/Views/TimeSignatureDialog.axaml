<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="150"
        x:Class="OpenUtau.App.Views.TimeSignatureDialog"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource dialogs.timesig.caption}"
        Width="320" MinWidth="280" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="Button.footer">
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Border Margin="{Binding $parent[Window].WindowDecorationMargin}">
    <StackPanel Margin="12" Spacing="10">

      <!-- ส่วนเลือกจังหวะ -->
      <Grid ColumnDefinitions="*,8,*">
        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                  PlaceholderText="—"
                  ItemsSource="{Binding BeatPerBars}"
                  SelectedItem="{Binding BeatPerBar}"/>
        <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="—"
                  ItemsSource="{Binding BeatUnits}"
                  SelectedItem="{Binding BeatUnit}"/>
      </Grid>

      <!-- ปุ่ม -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="8" Margin="0,2,0,0">
        <Button Classes="footer accent"
                Content="{DynamicResource button.ok}"
                IsDefault="True"
                Click="OnOkButtonClick"/>
        <Button Classes="footer"
                Content="{DynamicResource button.cancel}"
                IsCancel="True"
                Click="OnCancelButtonClick"/>
      </StackPanel>

    </StackPanel>
  </Border>
</Window>