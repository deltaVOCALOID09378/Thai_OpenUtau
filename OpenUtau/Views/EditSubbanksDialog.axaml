<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.EditSubbanksDialog"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource singers.subbanks.edit}"
        WindowStartupLocation="CenterScreen"
        MinWidth="500" MinHeight="600" Width="500" Height="600"
        FontFamily="Leelawadee UI, sans-serif"
        Background="#1A1A1A" Foreground="#F0F0F0">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
      <Setter Property="Background" Value="#2D2D2D"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#CC2200"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF4422"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#991100"/>
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="*,10,160" Margin="10">
    <DataGrid Name="SuffixGrid" Grid.Column="0" SelectionMode="Extended" IsReadOnly="True"
              CanUserReorderColumns="False" CanUserSortColumns="False" AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}" SelectionChanged="OnSelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource singers.subbanks.tone}" Width="*" Binding="{Binding Tone}"/>
        <DataGridTextColumn Header="{StaticResource oto.prefix}" Width="*" Binding="{Binding Prefix}"/>
        <DataGridTextColumn Header="{StaticResource oto.suffix}" Width="*" Binding="{Binding Suffix}"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Column="2">
      <Grid RowDefinitions="Auto,*,Auto,*,Auto">
        <StackPanel VerticalAlignment="Top" Grid.Row="0">
          <ComboBox HorizontalAlignment="Stretch" Margin="0,0,0,4"
                    ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}"/>
          <Button Content="{DynamicResource singers.subbanks.color.add}" HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="OnAdd"/>
          <Button Content="{DynamicResource singers.subbanks.color.remove}" HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="OnRemove"
                  IsEnabled="{Binding IsEditableColor}"/>
          <Button Content="{DynamicResource singers.subbanks.color.rename}" HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="OnRename"
                  IsEnabled="{Binding IsEditableColor}"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Top" Grid.Row="2">
          <Button Content="{DynamicResource singers.subbanks.selectall}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="OnSelectAll"/>
          <TextBlock Text="{DynamicResource oto.prefix}"/>
          <TextBox Margin="0,4" Text="{Binding Prefix}"/>
          <TextBlock Text="{DynamicResource oto.suffix}"/>
          <TextBox Margin="0,4,0,8" Text="{Binding Suffix}"/>
          <Button Content="{DynamicResource singers.subbanks.set}" HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="OnSet"/>
          <Button Content="{DynamicResource singers.subbanks.clear}" HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="OnClear"/>
          <Button Content="{DynamicResource singers.subbanks.import}" HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="OnImportMap"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" Grid.Row="4">
          <Button Content="{DynamicResource button.reset}" HorizontalAlignment="Stretch" Margin="0,0,0,4" Command="{Binding LoadSubbanks}"/>
          <Button Content="{DynamicResource button.save}" HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="OnSave"/>
          <Button Content="{DynamicResource singers.subbanks.export}" HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="OnExportMap"/>
          <Button Content="{DynamicResource button.cancel}" Margin="0,4,0,0" HorizontalAlignment="Stretch" Click="OnCancel"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>