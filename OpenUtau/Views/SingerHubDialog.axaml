<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OpenUtau.App.Views"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.SingerHubDialog"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource lunai.caption}" Width="720" Height="560" WindowStartupLocation="CenterScreen"
        FontFamily="Leelawadee UI, sans-serif"
        Background="#1A1A1A" Foreground="#F0F0F0">
  
  <views:SingerHubPane />
  
</Window>