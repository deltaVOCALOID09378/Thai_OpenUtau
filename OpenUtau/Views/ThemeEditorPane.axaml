<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="OpenUtau.App.Views.ThemeEditorPane"
             x:DataType="vm:ThemeEditorViewModel"
             x:CompileBindings="True">

  <Grid>
    <!-- หัวข้อแผง -->
    <TextBlock Text="{DynamicResource themeeditor.title}" Classes="notePropsPanelTitle"
               Height="32" Margin="16,16,40,0"
               HorizontalAlignment="Left" VerticalAlignment="Top"/>

    <!-- ปุ่มปิดแผง (กรณีเปิดใน Dock) -->
    <Button x:Name="ClosePanelButton" Classes="workspacePanelClose"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
            IsVisible="False" Click="OnCloseDockedPanel"
            ToolTip.Tip="{DynamicResource workspace.panel.close}">
      <Path Classes="stroked"/>
    </Button>

    <!-- เนื้อหาหลัก -->
    <Grid RowDefinitions="*,auto" Margin="0,48,0,10">
      <ScrollViewer x:Name="ContentScroll" Grid.Row="0" Classes="workspaceScroll workspaceDockPanelScroll"
                    Margin="10,0,10,0"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    AllowAutoHide="False">
        <StackPanel Classes="workspacePanelSections" Spacing="5" HorizontalAlignment="Stretch">
          
          <!-- โหมดมืด -->
          <Grid ColumnDefinitions="*,auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource themeeditor.isdarkmode}"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkMode}"/>
          </Grid>
          
          <Separator Classes="workspacePanelSectionDivider"/>

          <!-- รายการหมวดหมู่ธีม -->
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Classes="workspacePanelSection" Spacing="5" Margin="0,0,0,8">
                  <TextBlock Classes="workspacePanelSectionTitle" Text="{Binding Title}"/>
                  
                  <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,auto,auto" Margin="0,0,0,4">
                          <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                     Text="{Binding DisplayName}"
                                     TextWrapping="Wrap"
                                     Margin="0,0,8,0"/>
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"
                                     Text="{Binding HexCode}"/>
                          <ColorPicker Grid.Column="2" Color="{Binding Color, Mode=TwoWay}" ColorSpectrumShape="Ring"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  
                  <Separator Classes="workspacePanelSectionDivider"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- ปุ่มด้านล่าง (Cancel / Save) -->
      <Grid Grid.Row="1" HorizontalAlignment="Stretch" ColumnDefinitions="*,10,*" Margin="10,8,10,0">
        <Button Grid.Column="0" Content="{DynamicResource themeeditor.cancel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnCancel"/>
        <Button Grid.Column="2" Content="{DynamicResource themeeditor.save}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnSave"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>