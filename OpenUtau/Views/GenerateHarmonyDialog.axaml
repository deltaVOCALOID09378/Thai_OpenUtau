<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        x:Class="OpenUtau.App.Views.GenerateHarmonyDialog"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource dialogs.harmony.caption}"
        FontFamily="Leelawadee UI, sans-serif"
        Background="#1A1A1A" Foreground="#F0F0F0">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#F0F0F0"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#333333"/>
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="FontFamily" Value="Leelawadee UI, sans-serif"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#444444"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#CC2200"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF4422"/>
    </Style>
  </Window.Styles>
  <StackPanel Margin="16" Spacing="10">
    <TextBlock TextWrapping="Wrap"
               Text="{DynamicResource dialogs.harmony.description}"/>
    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,8">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="lbl" Margin="0,0,12,0"
                 Text="{DynamicResource dialogs.harmony.key}"/>
      <ComboBox x:Name="KeyComboBox" Grid.Column="1" HorizontalAlignment="Stretch"
                SelectedItem="{Binding SelectedKeyOption}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:KeyOptionViewModel">
            <TextBlock Text="{Binding DisplayName}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <StackPanel Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="lbl" Text="{DynamicResource dialogs.harmony.intervals}" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox VerticalAlignment="Center" IsChecked="{Binding ThirdAbove}"/>
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource harmony.interval.thirdabove}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox VerticalAlignment="Center" IsChecked="{Binding ThirdBelow}"/>
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource harmony.interval.thirdbelow}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox VerticalAlignment="Center" IsChecked="{Binding FifthAbove}"/>
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource harmony.interval.fifthabove}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox VerticalAlignment="Center" IsChecked="{Binding FifthBelow}"/>
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource harmony.interval.fifthbelow}"/>
      </StackPanel>
    </StackPanel>
    <TextBlock Opacity="0.75" TextWrapping="Wrap" FontSize="11"
               Text="{DynamicResource dialogs.harmony.hint}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
      <Button MinWidth="80" Content="{DynamicResource button.cancel}" Click="OnCancel" Padding="12,6"/>
      <Button MinWidth="80" Content="{DynamicResource button.ok}" Classes="accent" Click="OnOk" Padding="12,6"/>
    </StackPanel>
  </StackPanel>
</Window>