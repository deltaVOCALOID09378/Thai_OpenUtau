<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="440"
        x:Class="OpenUtau.App.Views.TranscribeDialog"
        x:DataType="vm:TranscribeViewModel"
        x:CompileBindings="True"
        Icon="/Assets/Thai OpenUtau Logo.ico"
        Title="{DynamicResource dialogs.transcribe.caption}"
        WindowStartupLocation="CenterOwner"
        Width="440" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False">

  <Window.Styles>
    <!-- หัวข้อ -->
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ป้ายหน้าตัวเลือก: ขึ้นบรรทัดใหม่ได้ ไม่ถูกตัด -->
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="180"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <!-- การ์ด -->
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- ช่องตัวเลข -->
    <Style Selector="NumericUpDown.value">
      <Setter Property="Width" Value="76"/>
      <Setter Property="ShowButtonSpinner" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Slider.fader">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.footer">
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Border Margin="{Binding $parent[Window].WindowDecorationMargin}">
    <DockPanel Margin="12">

      <!-- ===== ปุ่ม OK / Cancel ===== -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                  HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
        <Button Name="OkButton" Classes="footer accent"
                Content="{DynamicResource button.ok}"
                IsDefault="True"
                IsEnabled="{Binding CanRun}"
                Click="OnOkClicked"/>
        <Button Classes="footer"
                Content="{DynamicResource button.cancel}"
                IsCancel="True"
                Click="OnCancelClicked"/>
      </StackPanel>

      <StackPanel Spacing="10">

        <!-- ===== อัลกอริทึม ===== -->
        <Border Classes="section">
          <StackPanel Spacing="8">
            <TextBlock Classes="header"
                       Text="{DynamicResource dialogs.transcribe.midialgorithm}"/>

            <StackPanel Orientation="Horizontal" Spacing="20">
              <Panel Background="Transparent" ToolTip.Tip="{Binding GameNotFoundTip}">
                <RadioButton GroupName="MidiAlgorithm" Content="GAME"
                             IsChecked="{Binding UseGame}"
                             IsEnabled="{Binding GameAvailable}"/>
              </Panel>
              <Panel Background="Transparent" ToolTip.Tip="{Binding SomeNotFoundTip}">
                <RadioButton GroupName="MidiAlgorithm" Content="SOME"
                             IsChecked="{Binding UseSome}"
                             IsEnabled="{Binding SomeAvailable}"/>
              </Panel>
            </StackPanel>

            <!-- RMVPE: CheckBox ปกติ ใช้คีย์บอร์ดได้ และเป็นสีเทาเองเมื่อใช้งานไม่ได้ -->
            <Panel Background="Transparent" HorizontalAlignment="Left"
                   ToolTip.Tip="{Binding RmvpeNotFoundTip}">
              <CheckBox x:Name="RmvpeCheck" Content="{DynamicResource dialogs.transcribe.rmvpe}"
                        IsChecked="{Binding PredictPitd}"
                        IsEnabled="{Binding RmvpeAvailable}"/>
            </Panel>
          </StackPanel>
        </Border>

        <!-- ===== ตัวเลือก GAME ===== -->
        <Border Classes="section" IsVisible="{Binding GameOptionsVisible}">
          <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
            <TextBlock Classes="header"
                       Text="{DynamicResource dialogs.transcribe.game.options}"/>

            <!-- Language -->
            <Grid IsVisible="{Binding GameHasLanguages}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Classes="label" Text="{DynamicResource dialogs.transcribe.game.language}"/>
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding LanguageDisplayOptions}"
                        SelectedIndex="{Binding LanguageDisplayIndex}"/>
            </Grid>

            <!-- Sampling Steps -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Classes="label" Text="{DynamicResource dialogs.transcribe.game.steps}"/>
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding SamplingStepsOptions}"
                        SelectedIndex="{Binding SamplingStepsIndex}"/>
            </Grid>

            <!-- Boundary Threshold -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Classes="label" Text="{DynamicResource dialogs.transcribe.game.segthreshold}"/>
              <NumericUpDown Grid.Column="1" Classes="value"
                             Value="{Binding BoundaryThreshold}"
                             Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"/>
              <Slider Grid.Column="2" Classes="fader"
                      Value="{Binding BoundaryThreshold}"
                      Minimum="0" Maximum="1"
                      TickFrequency="0.01" IsSnapToTickEnabled="True"/>
            </Grid>

            <!-- Boundary Radius -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Classes="label" Text="{DynamicResource dialogs.transcribe.game.segradius}"/>
              <NumericUpDown Grid.Column="1" Classes="value"
                             Value="{Binding BoundaryRadius}"
                             Minimum="0" Maximum="10" Increment="1" FormatString="F0"/>
              <Slider Grid.Column="2" Classes="fader"
                      Value="{Binding BoundaryRadius}"
                      Minimum="0" Maximum="10"
                      TickFrequency="1" IsSnapToTickEnabled="True"/>
            </Grid>

            <!-- Score Threshold -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Classes="label" Text="{DynamicResource dialogs.transcribe.game.estthreshold}"/>
              <NumericUpDown Grid.Column="1" Classes="value"
                             Value="{Binding ScoreThreshold}"
                             Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"/>
              <Slider Grid.Column="2" Classes="fader"
                      Value="{Binding ScoreThreshold}"
                      Minimum="0" Maximum="1"
                      TickFrequency="0.01" IsSnapToTickEnabled="True"/>
            </Grid>

            <!-- Batch Size -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Classes="label" Text="{DynamicResource dialogs.transcribe.game.batchsize}"/>
              <NumericUpDown Grid.Column="1" Classes="value"
                             Value="{Binding BatchSize}"
                             Minimum="1" Maximum="32" Increment="1" FormatString="F0"/>
              <Slider Grid.Column="2" Classes="fader"
                      Value="{Binding BatchSize}"
                      Minimum="1" Maximum="32"
                      TickFrequency="1" IsSnapToTickEnabled="True"/>
            </Grid>

            <!-- Max Batch Duration -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Classes="label" Text="{DynamicResource dialogs.transcribe.game.batchduration}"/>
              <NumericUpDown Grid.Column="1" Classes="value"
                             Value="{Binding MaxBatchDuration}"
                             Minimum="10" Maximum="600" Increment="10" FormatString="F0"/>
              <Slider Grid.Column="2" Classes="fader"
                      Value="{Binding MaxBatchDuration}"
                      Minimum="10" Maximum="600"
                      TickFrequency="10" IsSnapToTickEnabled="True"/>
            </Grid>

          </StackPanel>
        </Border>

      </StackPanel>
    </DockPanel>
  </Border>
</Window>