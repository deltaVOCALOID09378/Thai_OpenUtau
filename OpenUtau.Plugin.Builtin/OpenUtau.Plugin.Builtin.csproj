<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8612;CS8618;CS8619;CS8622;CS8625;CS8629;CS8632;CS8714;CS8765;CS8767;CS8769;CS0108;CS0162;CS0168;CS0219;CS0414;CS0436;CS0612;CS0618;CS0649;CA2255;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AI_Agent_Commands_And_Archive\**" />
    <EmbeddedResource Remove="AI_Agent_Commands_And_Archive\**" />
    <None Remove="AI_Agent_Commands_And_Archive\**" />
    <Compile Remove=".agents\**" />
    <EmbeddedResource Remove=".agents\**" />
    <None Remove=".agents\**" />
    <Compile Remove="Dictionary\**" />
    <EmbeddedResource Remove="Dictionary\**" />
    <None Remove="Dictionary\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUtau.Core\OpenUtau.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Data\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Data\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
