    <Product>Thai OpenUtau</Product>
    <Company>DELTA SYNTH</Company>
    <Authors>DELTA SYNTH</Authors>
    <PackageProjectUrl>https://patiphatwongyai.wixsite.com/deltasynth</PackageProjectUrl>
    <ApplicationIcon>..\OpenUtau\Assets\open-utau.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8632;CS0649;CS0414;CS0219;AVLN3001;xUnit1013;xUnit2013;CS0612;CS0162;CS8619;CS0164;CS8629;CS0108;CS8981;CS0472;CS8769;CS8767;CS8612;CS8714;CS0168;CS0618</NoWarn>
